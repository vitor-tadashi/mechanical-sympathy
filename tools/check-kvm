#!/usr/bin/env bash
#
# check-kvm - spike for Level 3 of the validation ladder: boot a Rocky Linux 9 GenericCloud
# image in QEMU, and time it.
#
# The VM has 4 vCPUs on 2 NUMA nodes and 4 GiB of RAM. cloud-init runs a script at every
# boot that prints marker lines on the serial console: the kernel command line, the NUMA
# layout and lscpu. On the first boot it adds a kernel argument with grubby and reboots.
# On the second boot it checks that the argument is on the command line, and powers off.
# The host side records when each marker appeared.
#
#   tools/check-kvm [--accel kvm|tcg] [--work DIR] [--timeout SECONDS]
#
# --accel kvm needs a usable /dev/kvm (exit 3 when it is not). --accel tcg is QEMU's
# software emulation: slow, and the fallback when a runner has no KVM.
# Needs qemu-system-x86_64, qemu-img, cloud-localds (cloud-image-utils), curl, sha256sum.
# The results go to $GITHUB_STEP_SUMMARY when it is set, and to standard output.

set -Eeuo pipefail
export LC_ALL=C

IMAGE_NAME=Rocky-9-GenericCloud-Base.latest.x86_64.qcow2
IMAGE_URL="https://dl.rockylinux.org/pub/rocky/9/images/x86_64/${IMAGE_NAME}"
SPIKE_ARG=lowlat_spike=1

ACCEL=kvm
WORK=""
TIMEOUT=1200

die() {
	printf 'check-kvm: %s\n' "$*" >&2
	exit 1
}

# guest_script - runs in the VM at every boot, from /var/lib/cloud/scripts/per-boot.
guest_script() {
	cat <<'EOF'
#!/bin/bash
exec >/dev/ttyS0 2>&1
state=/var/lib/spike-boot-count
boot=$(( $(cat "${state}" 2>/dev/null || echo 0) + 1 ))
echo "${boot}" >"${state}"
echo "SPIKE-BEGIN boot=${boot} uptime=$(cut -d' ' -f1 /proc/uptime)"
echo "SPIKE-CMDLINE $(cat /proc/cmdline)"
for node in /sys/devices/system/node/node[0-9]*; do
	echo "SPIKE-NUMA ${node##*/} cpus=$(cat "${node}/cpulist") mem=$(awk '/MemTotal/ { print $4 " kB" }' "${node}/meminfo")"
done
echo "SPIKE-LSCPU $(lscpu | awk -F': +' '/^(Model name|Hypervisor vendor|NUMA node\(s\)|CPU\(s\)):/ { printf "%s=%s; ", $1, $2 }')"
echo "SPIKE-ANALYZE $(systemd-analyze 2>&1 | head -n 1)"
if [ "${boot}" = 1 ]; then
	grubby --update-kernel=ALL --args=lowlat_spike=1
	echo "SPIKE-GRUBBY exit=$?"
	echo "SPIKE-GRUBBY-ARGS $(grubby --info=DEFAULT | grep '^args=')"
	sync
	systemctl --no-block reboot
	exit 0
fi
if grep -qw lowlat_spike=1 /proc/cmdline; then
	echo "SPIKE-RESULT grubby-argument-survived=yes"
else
	echo "SPIKE-RESULT grubby-argument-survived=no"
fi
sync
systemctl --no-block poweroff
EOF
}

# user_data - cloud-config that installs the guest script as a per-boot script.
user_data() {
	printf '#cloud-config\n'
	printf 'write_files:\n'
	printf '  - path: /var/lib/cloud/scripts/per-boot/50-spike\n'
	printf '    permissions: "0755"\n'
	printf '    content: |\n'
	guest_script | sed 's/^/      /'
}

require_tools() {
	local tool
	for tool in qemu-system-x86_64 qemu-img cloud-localds curl sha256sum; do
		command -v "${tool}" >/dev/null 2>&1 || die "missing command: ${tool}"
	done
}

# fetch_image - the base image, with its SHA-256 checked against the published one.
fetch_image() {
	local expected actual
	curl -fsSL --retry 3 -o "${WORK}/${IMAGE_NAME}.CHECKSUM" "${IMAGE_URL}.CHECKSUM"
	expected="$(awk -v name="${IMAGE_NAME}" '$1 == "SHA256" && $2 == "(" name ")" { print $4 }' "${WORK}/${IMAGE_NAME}.CHECKSUM")"
	[[ -n "${expected}" ]] || die "no SHA-256 for ${IMAGE_NAME} in the published checksum file"
	curl -fsSL --retry 3 -o "${WORK}/base.qcow2" "${IMAGE_URL}"
	actual="$(sha256sum "${WORK}/base.qcow2")"
	actual="${actual%% *}"
	[[ "${actual}" == "${expected}" ]] || die "checksum mismatch for ${IMAGE_NAME}: ${actual} instead of ${expected}"
}

# start_vm - QEMU in the background, serial console in a file.
start_vm() {
	local accel_args
	if [[ "${ACCEL}" == kvm ]]; then
		accel_args="-accel kvm -cpu host"
	else
		accel_args="-accel tcg -cpu max"
	fi
	qemu-img create -q -f qcow2 -b "${WORK}/base.qcow2" -F qcow2 "${WORK}/disk.qcow2" 20G
	user_data >"${WORK}/user-data"
	printf 'instance-id: spike-1\nlocal-hostname: spike\n' >"${WORK}/meta-data"
	cloud-localds "${WORK}/seed.iso" "${WORK}/user-data" "${WORK}/meta-data"
	# accel_args holds several words: it must split.
	# shellcheck disable=SC2086
	qemu-system-x86_64 -machine q35 ${accel_args} -smp 4,sockets=2,cores=2,threads=1 -m 4G \
		-object memory-backend-ram,id=m0,size=2G -object memory-backend-ram,id=m1,size=2G \
		-numa node,nodeid=0,cpus=0-1,memdev=m0 -numa node,nodeid=1,cpus=2-3,memdev=m1 \
		-drive "file=${WORK}/disk.qcow2,if=virtio,format=qcow2" \
		-drive "file=${WORK}/seed.iso,if=virtio,format=raw,media=cdrom,readonly=on" \
		-nic user,model=virtio-net-pci -display none -monitor none -serial "file:${WORK}/serial.log" &
	QEMU_PID=$!
}

# seen <pattern> <times> - true when the serial log matches the pattern at least that often.
seen() {
	local matches
	matches="$(grep -c -- "$1" "${WORK}/serial.log" 2>/dev/null || true)"
	((${matches:-0} >= $2))
}

# wait_for_vm - polls the serial log once a second and records when each marker showed up.
wait_for_vm() {
	local started="${SECONDS}" elapsed
	T_FIRST="" T_LOGIN1="" T_BEGIN1="" T_LOGIN2="" T_BEGIN2="" T_RESULT="" T_EXIT=""
	while kill -0 "${QEMU_PID}" 2>/dev/null; do
		elapsed=$((SECONDS - started))
		if ((elapsed >= TIMEOUT)); then
			kill "${QEMU_PID}" 2>/dev/null || true
			TIMED_OUT=1
			return 0
		fi
		if [[ -z "${T_FIRST}" && -s "${WORK}/serial.log" ]]; then T_FIRST="${elapsed}"; fi
		if [[ -z "${T_LOGIN1}" ]] && seen 'login:' 1; then T_LOGIN1="${elapsed}"; fi
		if [[ -z "${T_BEGIN1}" ]] && seen 'SPIKE-BEGIN boot=1' 1; then T_BEGIN1="${elapsed}"; fi
		if [[ -z "${T_LOGIN2}" ]] && seen 'login:' 2; then T_LOGIN2="${elapsed}"; fi
		if [[ -z "${T_BEGIN2}" ]] && seen 'SPIKE-BEGIN boot=2' 1; then T_BEGIN2="${elapsed}"; fi
		if [[ -z "${T_RESULT}" ]] && seen 'SPIKE-RESULT' 1; then T_RESULT="${elapsed}"; fi
		sleep 1
	done
	T_EXIT=$((SECONDS - started))
}

# row <label> <seconds> - a table row: seconds, or n/a when the marker never showed up.
row() {
	if [[ -n "$2" ]]; then
		printf '| %s | %s s |\n' "$1" "$2"
	else
		printf '| %s | n/a |\n' "$1"
	fi
}

report() {
	local kvm_state="$1" download="$2" outcome="$3"
	{
		printf '### check-kvm: Rocky Linux 9 GenericCloud, accel=%s\n\n' "${ACCEL}"
		printf '| Measure | Value |\n|---|---|\n'
		printf '| /dev/kvm | %s |\n' "${kvm_state}"
		row "image download and checksum" "${download}"
		row "first serial output" "${T_FIRST}"
		row "login prompt, boot 1" "${T_LOGIN1}"
		row "cloud-init per-boot script, boot 1" "${T_BEGIN1}"
		row "cloud-init per-boot script, boot 2 (after the grubby edit and a reboot)" "${T_BEGIN2}"
		row "login prompt, boot 2" "${T_LOGIN2}"
		row "result marker" "${T_RESULT}"
		row "VM powered off" "${T_EXIT}"
		printf '| outcome | %s |\n\n' "${outcome}"
		printf 'Guest markers:\n\n```\n'
		grep -a -E 'SPIKE-|Linux version' "${WORK}/serial.log" | tr -d '\r' | cut -c1-240 || true
		printf '```\n'
	} | tee -a "${GITHUB_STEP_SUMMARY:-/dev/null}"
}

main() {
	local download_start download kvm_state outcome=passed
	while (($# > 0)); do
		case "$1" in
		--accel)
			[[ $# -ge 2 ]] || die "--accel needs kvm or tcg"
			ACCEL="$2"
			shift
			;;
		--work)
			[[ $# -ge 2 ]] || die "--work needs a directory"
			WORK="$2"
			shift
			;;
		--timeout)
			[[ $# -ge 2 ]] || die "--timeout needs a number of seconds"
			TIMEOUT="$2"
			shift
			;;
		*) die "unknown option $1 (usage: tools/check-kvm [--accel kvm|tcg] [--work DIR] [--timeout SECONDS])" ;;
		esac
		shift
	done
	[[ "${ACCEL}" == kvm || "${ACCEL}" == tcg ]] || die "--accel is kvm or tcg"
	if [[ "${ACCEL}" == kvm ]]; then
		[[ -c /dev/kvm && -r /dev/kvm && -w /dev/kvm ]] || {
			printf 'check-kvm: /dev/kvm is missing or not usable by this user\n' >&2
			exit 3
		}
		kvm_state="usable"
	else
		kvm_state="not used (TCG)"
	fi
	require_tools
	[[ -n "${WORK}" ]] || WORK="$(mktemp -d)"
	mkdir -p "${WORK}"
	TIMED_OUT=0
	trap '[[ -z "${QEMU_PID:-}" ]] || kill "${QEMU_PID}" 2>/dev/null || true' EXIT

	download_start="${SECONDS}"
	fetch_image
	download=$((SECONDS - download_start))
	start_vm
	wait_for_vm

	if ((TIMED_OUT == 1)); then
		outcome="failed: timed out after ${TIMEOUT} s"
	elif ! grep -q 'SPIKE-RESULT grubby-argument-survived=yes' "${WORK}/serial.log"; then
		outcome="failed: the ${SPIKE_ARG} argument did not survive the reboot, or the VM never got there"
	fi
	report "${kvm_state}" "${download}" "${outcome}"
	[[ "${outcome}" == passed ]]
}

main "$@"
