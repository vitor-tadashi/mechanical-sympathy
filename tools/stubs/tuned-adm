#!/usr/bin/env bash
#
# tuned-adm (fake) - "profile NAME" and "active". A profile exists when its
# tuned.conf is in etc/tuned/NAME or usr/lib/tuned/NAME.

# shellcheck source=tools/stubs/lib/fake
. "$(dirname "${BASH_SOURCE[0]}")/lib/fake"

ACTIVE="${LOWLAT_ROOT}/etc/tuned/active_profile"
PROFILE_ROOT=/etc/tuned
VENDOR_ROOT=/usr/lib/tuned
major="$(awk -F'"' '/^VERSION_ID=/ { split($2, part, "."); print part[1] }' "${LOWLAT_ROOT}/etc/os-release")"
if [[ "${major}" == 10 ]]; then
	PROFILE_ROOT=/etc/tuned/profiles
	VENDOR_ROOT=/usr/lib/tuned/profiles
fi

[[ "${1:-}" == active ]] || fake_record "$@"
case "${1:-}" in
profile)
	[[ -f "${LOWLAT_ROOT}${PROFILE_ROOT}/$2/tuned.conf" || -f "${LOWLAT_ROOT}${VENDOR_ROOT}/$2/tuned.conf" ]] ||
		fake_fail 1 "Requested profile '$2' doesn't exist."
	printf '%s\n' "$2" >"${ACTIVE}"
	printf 'manual\n' >"${LOWLAT_ROOT}/etc/tuned/profile_mode"
	printf 'TUNED_BOOT_CMDLINE=\"\"\n' >"${LOWLAT_ROOT}/etc/tuned/bootcmdline"
	;;
off)
	: >"${ACTIVE}"
	printf 'manual\n' >"${LOWLAT_ROOT}/etc/tuned/profile_mode"
	printf 'TUNED_BOOT_CMDLINE=\"\"\n' >"${LOWLAT_ROOT}/etc/tuned/bootcmdline"
	;;
active)
	profile="$(cat "${ACTIVE}" 2>/dev/null || true)"
	[[ -n "${profile}" ]] || fake_fail 2 "No current active profile."
	printf 'Current active profile: %s\n' "${profile}"
	;;
*) fake_fail 1 "unsupported arguments: $*" ;;
esac
