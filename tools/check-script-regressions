	expect_status 0 systemctl start lowlat-runtime.service
	expect_status 0 "${REPO}/scripts/apply-all" --apply
	expect_status 0 "${REPO}/scripts/apply-all" --apply
	expect_status 0 "${REPO}/scripts/apply-all" --rollback
	expect_status 0 diff "${WORK}/unit-before" "${LOWLAT_ROOT}/etc/systemd/system/lowlat-runtime.service"
	expect_status 1 systemctl is-enabled --quiet lowlat-runtime.service
	expect_status 0 systemctl is-active --quiet lowlat-runtime.service
}

wrapper_no_apply() {
	setup rhel9-vm-kvm
	expect_status 0 "${REPO}/scripts/apply-all" --rollback
	[[ ! -s "${LOWLAT_ROOT}/run/fake-calls" ]] || fail "wrapper rollback changed an unapplied host"
	[[ ! -d "${LOWLAT_ROOT}/var/lib/lowlat/factory-settings" ]] || fail "wrapper rollback created state without apply"
}

wrapper_missing_state() {
	setup rhel9-vm-kvm
	expect_status 0 "${REPO}/scripts/apply-all" --apply
	rm "${LOWLAT_ROOT}/var/lib/lowlat/factory-settings/.values/apply-all/guides/04-network"
	expect_status 1 "${REPO}/scripts/apply-all" --rollback
	expect_status 1 systemctl is-enabled --quiet lowlat-runtime.service
	expect_status 3 systemctl is-active --quiet lowlat-runtime.service
}

wrapper_skipped_stage() {
	setup rhel9-vm-kvm
	printf '128\n' >"${LOWLAT_ROOT}/proc/sys/vm/nr_hugepages"
	expect_status 0 "${REPO}/scripts/apply-all" --apply
	expect_status 0 "${REPO}/scripts/apply-all" --rollback
	for guide in 00-bios-firmware 02-cpu-isolation 03-huge-pages; do
		grep -qx "    .*Skipping ${guide}: apply-all did not apply it on this host" "${WORK}/output" || fail "${guide} was not skipped"
		if grep -q "Rollback ${guide}" "${WORK}/output"; then fail "wrapper rolled back ${guide}, which the VM skipped"; fi
	done
	[[ "$(<"${LOWLAT_ROOT}/proc/sys/vm/nr_hugepages")" == 128 ]] || fail "rollback changed the huge page pool that apply never managed"
}

wrapper_legacy_unit() {
	setup rhel9-vm-kvm
	mkdir -p "${LOWLAT_ROOT}/etc/systemd/system"
	sed 's|^ExecStart=.*|ExecStart=/opt/lowlat/scripts/apply-all --runtime|' "${REPO}/scripts/systemd/lowlat-runtime.service" >"${LOWLAT_ROOT}/etc/systemd/system/lowlat-runtime.service"
	expect_status 0 systemctl enable lowlat-runtime.service
	expect_status 3 "${REPO}/scripts/apply-all" --rollback
	grep -q 'older apply-all' "${WORK}/output" || fail "legacy install was not explained"
	expect_status 0 systemctl is-enabled --quiet lowlat-runtime.service
	[[ -e "${LOWLAT_ROOT}/etc/systemd/system/lowlat-runtime.service" ]] || fail "legacy unit was removed"
	[[ ! -d "${LOWLAT_ROOT}/var/lib/lowlat/factory-settings" ]] || fail "refused rollback created state"
}

wrapper_foreign_unit() {
	setup rhel9-vm-kvm
	mkdir -p "${LOWLAT_ROOT}/etc/systemd/system"
	printf '[Service]\nType=oneshot\nExecStart=/usr/bin/true\n' >"${LOWLAT_ROOT}/etc/systemd/system/lowlat-runtime.service"
	cp "${LOWLAT_ROOT}/etc/systemd/system/lowlat-runtime.service" "${WORK}/unit-before"
	expect_status 0 systemctl enable lowlat-runtime.service
	expect_status 0 "${REPO}/scripts/apply-all" --rollback
	expect_status 0 diff "${WORK}/unit-before" "${LOWLAT_ROOT}/etc/systemd/system/lowlat-runtime.service"
	expect_status 0 systemctl is-enabled --quiet lowlat-runtime.service
}

os_refuse_manual_start() {
	setup rhel9-2s-ref
	# Like rpcbind.target on a real host: active, and started only as a dependency.
	mkdir -p "${LOWLAT_ROOT}/usr/lib/systemd/system"
	printf '[Unit]\nDescription=RPC bind target\nRefuseManualStart=yes\n' >"${LOWLAT_ROOT}/usr/lib/systemd/system/rpcbind.target"
	FAKE_DEPENDENCY_START=1 expect_status 0 systemctl start rpcbind.target
	expect_status 1 systemctl start rpcbind.target
	expect_status 0 "${REPO}/scripts/07-os-hygiene" --apply
	expect_status 3 systemctl is-active --quiet rpcbind.target
	expect_status 0 "${REPO}/scripts/07-os-hygiene" --rollback
	grep -q 'rpcbind.target refuses a manual start' "${WORK}/output" || fail "the refused start was not explained"
}

wrapper_guide_failure() {
	setup rhel9-vm-kvm
	expect_status 0 "${REPO}/scripts/apply-all" --apply
	: >"${LOWLAT_ROOT}/run/fake-fail-mount"
	expect_status 4 "${REPO}/scripts/apply-all" --rollback
	grep -q 'Rollback of 07-os-hygiene failed: going on with the other guides' "${WORK}/output" || fail "the failed guide was not reported"
	grep -q 'rollback of 07-os-hygiene failed and the other guides were rolled back' "${WORK}/output" || fail "the final error does not name the guide"
	grep -q 'Rollback 01-grub-bootloader' "${WORK}/output" || fail "the guides after the failed one were not rolled back"
	[[ ! -e "${LOWLAT_ROOT}/etc/systemd/system/lowlat-runtime.service" ]] || fail "runtime unit left installed after a failed guide"
	rm "${LOWLAT_ROOT}/run/fake-fail-mount"
	expect_status 0 "${REPO}/scripts/apply-all" --rollback
}

wrapper_partial_apply() {
	setup rhel9-vm-kvm
	rm "${WORK}/bin/chronyc"
	expect_status 3 "${REPO}/scripts/apply-all" --apply
	expect_status 0 "${REPO}/scripts/apply-all" --rollback
	if grep -q 'Rollback 11-day2-operations' "${WORK}/output"; then fail "wrapper rolled back a guide it never reached"; fi
	[[ ! -e "${LOWLAT_ROOT}/etc/security/limits.d/90-lowlat.conf" ]] || fail "partial apply was not restored"
}

memory_swapoff_precheck() {
	setup rhel9-2s-ref
	cp "${LOWLAT_ROOT}/etc/fstab" "${WORK}/fstab-before"
	# 4 GiB on swap and 1 GiB available: swapoff would end in the OOM killer.
	sed -i 's/^SwapFree:.*/SwapFree:       0 kB/; s/^MemAvailable:.*/MemAvailable:   1048576 kB/' "${LOWLAT_ROOT}/proc/meminfo"
	expect_status 3 "${REPO}/scripts/12-memory-pressure" --apply
	grep -q 'swapoff would push the host into the OOM killer' "${WORK}/output" || fail "the swapoff refusal was not explained"
	expect_status 0 diff "${WORK}/fstab-before" "${LOWLAT_ROOT}/etc/fstab"
	grep -q '^/dev/mapper/rhel-swap' "${LOWLAT_ROOT}/proc/swaps" || fail "swap turned off despite the precheck"
	if grep -q swapoff "${LOWLAT_ROOT}/run/fake-calls" 2>/dev/null; then fail "swapoff ran despite the precheck"; fi
}

memory_rollback() {
	local dropin
	setup rhel9-2s-ref
	dropin="${LOWLAT_ROOT}/etc/systemd/system/lowlat-app.service.d/20-lowlat-memory.conf"
	cp "${LOWLAT_ROOT}/etc/fstab" "${WORK}/fstab-before"
	printf 'Y\n' >"${LOWLAT_ROOT}/sys/module/zswap/parameters/enabled"
	expect_status 0 "${REPO}/scripts/12-memory-pressure" --apply
	grep -qx N "${LOWLAT_ROOT}/sys/module/zswap/parameters/enabled" || fail "zswap left on"
	if grep -q '^/dev/' "${LOWLAT_ROOT}/proc/swaps"; then fail "swap left on"; fi
	if grep -q '^/dev/mapper/rhel-swap' "${LOWLAT_ROOT}/etc/fstab"; then fail "fstab swap line left active"; fi
	grep -qx 'OOMScoreAdjust=-900' "${dropin}" || fail "missing OOM score drop-in"
	host_boot "${LOWLAT_ROOT}" "${WORK}/pristine" >"${WORK}/output" 2>&1
	if grep -q '^/dev/' "${LOWLAT_ROOT}/proc/swaps"; then fail "swap came back at boot"; fi
	expect_status 0 "${REPO}/scripts/12-memory-pressure" --rollback
	expect_status 0 diff "${WORK}/fstab-before" "${LOWLAT_ROOT}/etc/fstab"
	grep -q '^/dev/mapper/rhel-swap' "${LOWLAT_ROOT}/proc/swaps" || fail "swap not turned back on"
	[[ ! -e "${dropin}" ]] || fail "drop-in left behind"
	expect_status 0 "${REPO}/scripts/12-memory-pressure" --rollback
	grep -c '^/dev/mapper/rhel-swap' "${LOWLAT_ROOT}/proc/swaps" | grep -qx 1 || fail "a second rollback activated swap twice"
}

memory_keeps_noatime() {
	setup rhel9-2s-ref
	expect_status 0 "${REPO}/scripts/07-os-hygiene" --apply
	expect_status 0 "${REPO}/scripts/12-memory-pressure" --apply
	expect_status 0 "${REPO}/scripts/12-memory-pressure" --rollback
	grep -q 'noatime' "${LOWLAT_ROOT}/etc/fstab" || fail "rolling back Guide 12 undid the noatime of Guide 07"
	grep -q '^/dev/mapper/rhel-swap  none   swap' "${LOWLAT_ROOT}/etc/fstab" || fail "swap line not restored"
}

memory_zswap_restore() {
	setup rhel9-2s-ref
	printf 'Y\n' >"${LOWLAT_ROOT}/sys/module/zswap/parameters/enabled"
	expect_status 0 "${REPO}/scripts/12-memory-pressure" --apply
	expect_status 0 "${REPO}/scripts/12-memory-pressure" --rollback
	grep -qx Y "${LOWLAT_ROOT}/sys/module/zswap/parameters/enabled" || fail "zswap not restored"
}

memory_protect() {
	setup rhel9-2s-ref
	sed -i 's/^SWAP_POLICY=.*/SWAP_POLICY=protect/' "${LOWLAT_ROOT}/etc/lowlat/lowlat.conf"
	expect_status 0 "${REPO}/scripts/12-memory-pressure" --apply
	grep -q '^/dev/mapper/rhel-swap' "${LOWLAT_ROOT}/proc/swaps" || fail "protect turned swap off"
	grep -qx 1 "${LOWLAT_ROOT}/proc/sys/vm/swappiness" || fail "swappiness not lowered"
	grep -qx 'MemorySwapMax=0' "${LOWLAT_ROOT}/etc/systemd/system/lowlat-app.service.d/20-lowlat-memory.conf" || fail "no MemorySwapMax on cgroup v2"
	expect_status 0 "${REPO}/scripts/12-memory-pressure" --verify
	expect_status 0 "${REPO}/scripts/12-memory-pressure" --rollback
	grep -qx 60 "${LOWLAT_ROOT}/proc/sys/vm/swappiness" || fail "swappiness not restored"
	[[ ! -e "${LOWLAT_ROOT}/etc/sysctl.d/91-lowlat-memory.conf" ]] || fail "sysctl file left behind"
}

memory_bad_policy() {
	setup rhel9-vm-kvm
	printf 'SWAP_POLICY=sometimes\n' >>"${LOWLAT_ROOT}/etc/lowlat/lowlat.conf"
	expect_status 3 "${REPO}/scripts/12-memory-pressure" --apply
	[[ ! -d "${LOWLAT_ROOT}/var/lib/lowlat/factory-settings/.values/12" ]] || fail "a bad policy must be refused before any state is saved"
}

if [[ "${1:-}" == --case ]]; then
	"$2"
	exit 0
fi
cases=(missing_system_conf tuned_layout missing_chrony existing_manager missing_chrony_unit console_restore grub_managed_irq virtio_placement unknown_irq unreadable_irq cpu_rollback cpu_absent_files cpu_lost_backup cpu_no_apply cpu_missing_knob cpu_runtime_only cpu_corrupt_state network_rollback network_missing_interface network_no_apply network_recreated_irqs network_driver_failure network_unsupported bypass_vm_verify network_missing_state os_rollback os_no_apply os_existing_files os_runtime_optins os_missing_state os_restore_failure os_masked_active_service wrapper_rollback wrapper_existing_unit wrapper_no_apply wrapper_missing_state wrapper_partial_apply wrapper_skipped_stage wrapper_legacy_unit wrapper_foreign_unit wrapper_guide_failure os_refuse_manual_start memory_swapoff_precheck memory_rollback memory_keeps_noatime memory_zswap_restore memory_protect memory_bad_policy)
for name in "${cases[@]}"; do
	bash "$0" --case "${name}"
done
printf 'check-script-regressions: %s cases passed\n' "${#cases[@]}"
