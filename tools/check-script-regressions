wrapper_rollback() {
	setup rhel9-vm-kvm
	cp -a "${LOWLAT_ROOT}/run/fake-ethtool" "${WORK}/nic-before"
	expect_status 0 "${REPO}/scripts/apply-all" --apply
	expect_status 0 "${REPO}/scripts/apply-all" --runtime
	: >"${LOWLAT_ROOT}/run/fake-calls"
	expect_status 0 "${REPO}/scripts/apply-all" --rollback
	awk '/Rollback [0-9]/ {print $NF}' "${WORK}/output" >"${WORK}/order"
	# A VM skips guides 00, 02 and 03: their capabilities do not apply there.
	printf '%s\n' 11-day2-operations 08-kernel-bypass 04-network 05-cgroup-isolation 10-time-sync 12-memory-pressure 07-os-hygiene 06-kernel-sysctl 01-grub-bootloader >"${WORK}/expected-order"
	expect_status 0 diff "${WORK}/expected-order" "${WORK}/order"
	head -n 2 "${LOWLAT_ROOT}/run/fake-calls" >"${WORK}/first-calls"
	printf 'systemctl stop lowlat-runtime.service\nsystemctl disable lowlat-runtime.service\n' >"${WORK}/expected-calls"
	expect_status 0 diff "${WORK}/expected-calls" "${WORK}/first-calls"
	[[ ! -e "${LOWLAT_ROOT}/etc/systemd/system/lowlat-runtime.service" ]] || fail "runtime unit left installed"
	expect_status 1 systemctl is-enabled --quiet lowlat-runtime.service
	expect_status 3 systemctl is-active --quiet lowlat-runtime.service
	expect_status 0 diff -r "${WORK}/nic-before" "${LOWLAT_ROOT}/run/fake-ethtool"
	expect_status 0 "${REPO}/scripts/apply-all" --rollback
	host_boot "${LOWLAT_ROOT}" "${WORK}/pristine" >"${WORK}/output" 2>&1
	expect_status 0 diff -r "${WORK}/nic-before" "${LOWLAT_ROOT}/run/fake-ethtool"
}

