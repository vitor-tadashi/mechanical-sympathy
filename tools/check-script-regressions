#!/usr/bin/env bash
# Focused regressions for the guide scripts, using the Level 1 fake hosts.
# Fixture values are illustrative, not measurements.
# Needs Linux and GNU tools, like tools/check-scripts.
set -Eeuo pipefail
export LC_ALL=C
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
STUBS="${REPO}/tools/stubs"
# shellcheck source=tools/stubs/lib/host
. "${STUBS}/lib/host"

fail() {
	printf 'check-script-regressions: %s\n' "$*" >&2
	[[ ! -f "${WORK}/output" ]] || cat "${WORK}/output" >&2
	exit 1
}

expect_status() {
	local expected="$1" status=0
	shift
	"$@" >"${WORK}/output" 2>&1 || status=$?
	[[ "${status}" == "${expected}" ]] || fail "expected exit ${expected}, got ${status}: $*"
}

setup() {
	local name="$1" tool path config="${REPO}/scripts/lowlat.conf.example"
	WORK="$(mktemp -d)"
	trap 'rm -rf "${WORK}"' EXIT
	export LOWLAT_ROOT="${WORK}/root"
	mkdir -p "${WORK}/bin"
	for tool in bash sh cat sed gawk grep tr cut sort uniq wc head tail tee find xargs basename dirname readlink mkdir rm cp mv chmod ln touch date diff getconf id printf env mktemp; do
		path="$(command -v "${tool}")"
		ln -s "${path}" "${WORK}/bin/${tool}"
	done
	ln -s gawk "${WORK}/bin/awk"
	for path in "${STUBS}"/*; do
		[[ -f "${path}" ]] || continue
		printf '#!/bin/sh\nexec %s "$@"\n' "${path}" >"${WORK}/bin/${path##*/}"
		chmod +x "${WORK}/bin/${path##*/}"
	done
	export PATH="${WORK}/bin"
	[[ ! -f "${REPO}/scripts/fixtures/hosts/${name}/lowlat.conf" ]] || config="${REPO}/scripts/fixtures/hosts/${name}/lowlat.conf"
	host_build "${LOWLAT_ROOT}" "${REPO}/scripts/fixtures/hosts/${name}/host" "${config}"
	cp -a "${LOWLAT_ROOT}" "${WORK}/pristine"
	host_boot "${LOWLAT_ROOT}" "${WORK}/pristine" >"${WORK}/output" 2>&1
}

missing_system_conf() {
	setup rhel10-2s-ref
	[[ ! -e "${LOWLAT_ROOT}/etc/systemd/system.conf" ]] || fail "RHEL 10 fixture must not have a local system.conf"
	expect_status 0 "${REPO}/scripts/02-cpu-isolation" --apply
	grep -qx '\[Manager\]' "${LOWLAT_ROOT}/etc/systemd/system.conf" || fail "new system.conf needs [Manager]"
	grep -q '^CPUAffinity=' "${LOWLAT_ROOT}/etc/systemd/system.conf" || fail "missing CPUAffinity"
}

tuned_layout() {
	setup rhel10-2s-ref
	expect_status 0 "${REPO}/scripts/07-os-hygiene" --apply
	[[ -f "${LOWLAT_ROOT}/etc/tuned/profiles/low-latency/tuned.conf" ]] || fail "RHEL 10 profile must use profiles directory"
	expect_status 1 tuned-adm profile nonexistent
}

missing_chrony() {
	setup rhel9-vm-kvm
	rm -f "${WORK}/bin/chronyc"
	expect_status 3 "${REPO}/scripts/10-time-sync" --apply
	grep -q 'dnf install chrony' "${WORK}/output" || fail "missing chrony package hint"
	[[ ! -d "${LOWLAT_ROOT}/etc/systemd/system/chronyd.service.d" ]] || fail "chrony precheck must precede writes"
	[[ ! -s "${LOWLAT_ROOT}/run/fake-calls" ]] || fail "chrony precheck must precede service changes"
}

existing_manager() {
	local count
	setup rhel9-2s-ref
	printf 'DefaultTimeoutStartSec=45s\n' >>"${LOWLAT_ROOT}/etc/systemd/system.conf"
	expect_status 0 "${REPO}/scripts/02-cpu-isolation" --apply
	expect_status 0 "${REPO}/scripts/02-cpu-isolation" --apply
	grep -qx 'DefaultTimeoutStartSec=45s' "${LOWLAT_ROOT}/etc/systemd/system.conf" || fail "lost unrelated manager setting"
	count="$(grep -c '^CPUAffinity=' "${LOWLAT_ROOT}/etc/systemd/system.conf")"
	[[ "${count}" == 1 ]] || fail "duplicate manager setting"
}

missing_chrony_unit() {
	setup rhel9-vm-kvm
	rm -f "${LOWLAT_ROOT}/usr/lib/systemd/system/chronyd.service"
	expect_status 3 "${REPO}/scripts/10-time-sync" --apply
	grep -q 'dnf install chrony' "${WORK}/output" || fail "missing package hint for absent chronyd unit"
	[[ ! -d "${LOWLAT_ROOT}/etc/systemd/system/chronyd.service.d" ]] || fail "absent-unit precheck must precede writes"
}

console_restore() {
	local entry
	setup rhel9-2s-ref
	entry="${LOWLAT_ROOT}/boot/loader/entries/0f1e2d3c4b5a69788796a5b4c3d2e1f0-0-rescue.conf"
	sed -i 's/ console=tty0/ console=ttyS0,115200n8/' "${entry}"
	cp -a "${LOWLAT_ROOT}/boot/loader/entries" "${WORK}/before-entries"
	expect_status 0 "${REPO}/scripts/01-grub-bootloader" --apply
	expect_status 0 "${REPO}/scripts/01-grub-bootloader" --apply
	expect_status 0 "${REPO}/scripts/01-grub-bootloader" --rollback
	expect_status 0 diff -r "${WORK}/before-entries" "${LOWLAT_ROOT}/boot/loader/entries"
	grep -q 'console=tty0' "${LOWLAT_ROOT}/boot/loader/entries/0f1e2d3c4b5a69788796a5b4c3d2e1f0-${KERNEL}.conf" || fail "console=tty0 not restored"
	grep -q 'console=ttyS0,115200n8' "${entry}" || fail "lost serial console"
	if grep -q 'console=tty0' "${entry}"; then fail "invented graphical console on rescue entry"; fi
	expect_status 0 "${REPO}/scripts/01-grub-bootloader" --rollback
}

virtio_placement() {
	setup rhel9-vm-kvm
	expect_status 0 "${REPO}/scripts/04-network" --apply
	grep -qx 1 "${LOWLAT_ROOT}/proc/irq/100/smp_affinity_list" || fail "virtio IRQ was not placed"
	grep -qx 0-3 "${LOWLAT_ROOT}/proc/irq/104/smp_affinity_list" || fail "management IRQ changed"
}

unknown_irq() {
	setup rhel9-vm-kvm
	find "${LOWLAT_ROOT}/sys" -type d -name msi_irqs -exec rm -rf {} +
	: >"${LOWLAT_ROOT}/proc/interrupts"
	# The inner shell sources the guide and evaluates its predicate.
	# shellcheck disable=SC2016
	expect_status 1 bash -c '. "$1"; irqs_on_cpus eth0 1' _ "${REPO}/scripts/04-network"
}

unreadable_irq() {
	setup rhel9-vm-kvm
	expect_status 0 "${REPO}/scripts/04-network" --apply
	host_kernel_sync "${LOWLAT_ROOT}"
	# The predicate must check every discovered vector, not just the first one.
	# shellcheck disable=SC2016
	expect_status 0 bash -c '. "$1"; irqs_on_cpus eth0 1' _ "${REPO}/scripts/04-network"
	rm -f "${LOWLAT_ROOT}/proc/irq/103/smp_affinity_list"
	# The inner shell evaluates the guide predicate against the missing file.
	# shellcheck disable=SC2016
	expect_status 1 bash -c '. "$1"; irqs_on_cpus eth0 1' _ "${REPO}/scripts/04-network"
}

cpu_rollback() {
	setup rhel9-2s-ref
	printf 'DefaultTimeoutStartSec=45s\n' >>"${LOWLAT_ROOT}/etc/systemd/system.conf"
	cp "${LOWLAT_ROOT}/etc/systemd/system.conf" "${WORK}/manager-before"
	mkdir -p "${LOWLAT_ROOT}/etc/sysctl.d"
	printf 'kernel.sched_rt_runtime_us = 800000\n' >"${LOWLAT_ROOT}/etc/sysctl.d/91-lowlat-rt.conf"
	printf '800000\n' >"${LOWLAT_ROOT}/proc/sys/kernel/sched_rt_runtime_us"
	printf '0000000f\n' >"${LOWLAT_ROOT}/sys/devices/virtual/workqueue/cpumask"
	expect_status 0 systemctl disable --now irqbalance
	expect_status 0 "${REPO}/scripts/02-cpu-isolation" --apply
	expect_status 0 "${REPO}/scripts/02-cpu-isolation" --apply
	expect_status 0 "${REPO}/scripts/02-cpu-isolation" --runtime
	expect_status 0 "${REPO}/scripts/02-cpu-isolation" --rollback
	expect_status 0 diff "${WORK}/manager-before" "${LOWLAT_ROOT}/etc/systemd/system.conf"
	grep -qx 800000 "${LOWLAT_ROOT}/proc/sys/kernel/sched_rt_runtime_us" || fail "RT baseline not restored"
	grep -qx 0000000f "${LOWLAT_ROOT}/sys/devices/virtual/workqueue/cpumask" || fail "workqueue baseline not restored"
	expect_status 1 systemctl is-enabled --quiet irqbalance
	expect_status 3 systemctl is-active --quiet irqbalance
	expect_status 0 "${REPO}/scripts/02-cpu-isolation" --rollback
}

cpu_absent_files() {
	setup rhel10-2s-ref
	expect_status 0 "${REPO}/scripts/02-cpu-isolation" --apply
	expect_status 0 "${REPO}/scripts/02-cpu-isolation" --rollback
	[[ ! -e "${LOWLAT_ROOT}/etc/systemd/system.conf" ]] || fail "created manager file left behind"
	[[ ! -e "${LOWLAT_ROOT}/etc/sysctl.d/91-lowlat-rt.conf" ]] || fail "created RT file left behind"
	expect_status 0 systemctl is-enabled --quiet irqbalance
	expect_status 0 systemctl is-active --quiet irqbalance
}

cpu_lost_backup() {
	setup rhel9-2s-ref
	expect_status 0 "${REPO}/scripts/02-cpu-isolation" --apply
	rm "${LOWLAT_ROOT}/var/lib/lowlat/factory-settings/etc/systemd/system.conf"
	expect_status 1 "${REPO}/scripts/02-cpu-isolation" --rollback
	expect_status 3 "${REPO}/scripts/02-cpu-isolation" --apply
}

cpu_no_apply() {
	setup rhel9-2s-ref
	expect_status 0 "${REPO}/scripts/02-cpu-isolation" --rollback
	[[ ! -d "${LOWLAT_ROOT}/var/lib/lowlat/factory-settings" ]] || fail "rollback without apply created state"
	expect_status 0 "${REPO}/scripts/02-cpu-isolation" --dry-run
	[[ ! -d "${LOWLAT_ROOT}/var/lib/lowlat/factory-settings" ]] || fail "dry run created state"
}

cpu_missing_knob() {
	setup rhel9-2s-ref
	expect_status 0 "${REPO}/scripts/02-cpu-isolation" --apply
	rm "${LOWLAT_ROOT}/sys/devices/virtual/workqueue/cpumask"
	expect_status 1 "${REPO}/scripts/02-cpu-isolation" --rollback
}

cpu_runtime_only() {
	setup rhel9-2s-ref
	cp "${LOWLAT_ROOT}/etc/systemd/system.conf" "${WORK}/manager-before"
	expect_status 0 "${REPO}/scripts/02-cpu-isolation" --runtime
	expect_status 0 "${REPO}/scripts/02-cpu-isolation" --rollback
	expect_status 0 diff "${WORK}/manager-before" "${LOWLAT_ROOT}/etc/systemd/system.conf"
	expect_status 0 systemctl is-active --quiet irqbalance
	grep -qx ffffffff "${LOWLAT_ROOT}/sys/devices/virtual/workqueue/cpumask" || fail "runtime-only baseline not restored"
}

cpu_corrupt_state() {
	setup rhel9-2s-ref
	expect_status 0 "${REPO}/scripts/02-cpu-isolation" --apply
	printf 'invalid\n' >"${LOWLAT_ROOT}/var/lib/lowlat/factory-settings/.values/02/workqueue"
	expect_status 1 "${REPO}/scripts/02-cpu-isolation" --rollback
}

if [[ "${1:-}" == --case ]]; then
	"$2"
	exit 0
fi
cases=(missing_system_conf tuned_layout missing_chrony existing_manager missing_chrony_unit console_restore virtio_placement unknown_irq unreadable_irq cpu_rollback cpu_absent_files cpu_lost_backup cpu_no_apply cpu_missing_knob cpu_runtime_only cpu_corrupt_state)
for name in "${cases[@]}"; do
	bash "$0" --case "${name}"
done
printf 'check-script-regressions: %s cases passed\n' "${#cases[@]}"
