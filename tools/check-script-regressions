	printf '800000\n' >"${LOWLAT_ROOT}/proc/sys/kernel/sched_rt_runtime_us"
	printf '0000000f\n' >"${LOWLAT_ROOT}/sys/devices/virtual/workqueue/cpumask"
	expect_status 0 systemctl disable --now irqbalance
	expect_status 0 "${REPO}/scripts/02-cpu-isolation" --apply
