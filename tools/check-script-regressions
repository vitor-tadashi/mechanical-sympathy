	grep -qx '\[Manager\]' "${LOWLAT_ROOT}/etc/systemd/system.conf" || fail "new system.conf needs [Manager]"
	grep -q '^CPUAffinity=' "${LOWLAT_ROOT}/etc/systemd/system.conf" || fail "missing CPUAffinity"
}

