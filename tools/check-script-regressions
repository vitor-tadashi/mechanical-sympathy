	setup rhel9-2s-ref
	entry="${LOWLAT_ROOT}/boot/loader/entries/0f1e2d3c4b5a69788796a5b4c3d2e1f0-0-rescue.conf"
	sed -i 's/ console=tty0/ console=ttyS0,115200n8/' "${entry}"
	cp -a "${LOWLAT_ROOT}/boot/loader/entries" "${WORK}/before-entries"
	expect_status 0 "${REPO}/scripts/01-grub-bootloader" --apply
	expect_status 0 "${REPO}/scripts/01-grub-bootloader" --apply
	expect_status 0 "${REPO}/scripts/01-grub-bootloader" --rollback
	expect_status 0 diff -r "${WORK}/before-entries" "${LOWLAT_ROOT}/boot/loader/entries"
	grep -q 'console=tty0' "${LOWLAT_ROOT}/boot/loader/entries/0f1e2d3c4b5a69788796a5b4c3d2e1f0-${KERNEL}.conf" || fail "console=tty0 not restored"
	grep -q 'console=ttyS0,115200n8' "${entry}" || fail "lost serial console"
	if grep -q 'console=tty0' "${entry}"; then fail "invented graphical console on rescue entry"; fi
	expect_status 0 "${REPO}/scripts/01-grub-bootloader" --rollback
}

grub_managed_irq() {
	local entry conf cpus
	setup rhel9-2s-ref
	entry="${LOWLAT_ROOT}/boot/loader/entries/0f1e2d3c4b5a69788796a5b4c3d2e1f0-${KERNEL}.conf"
	conf="${LOWLAT_ROOT}/etc/lowlat/lowlat.conf"
	# The inner shell reads ISOLATED_CPUS from the fixture configuration.
	# shellcheck disable=SC2016
	cpus="$(bash -c '. "$1"; IFS=,; printf "%s\n" "${ISOLATED_CPUS[*]}"' _ "${conf}")"
	sed -i 's/^GRUB_ISOLCPUS_MANAGED_IRQ=.*/GRUB_ISOLCPUS_MANAGED_IRQ=yes/' "${conf}"
	expect_status 0 "${REPO}/scripts/01-grub-bootloader" --apply
	expect_status 0 "${REPO}/scripts/01-grub-bootloader" --apply
	grep -o ' isolcpus=[^ ]*' "${entry}" >"${WORK}/isolcpus"
	printf ' isolcpus=managed_irq,domain,%s\n' "${cpus}" >"${WORK}/expected-isolcpus"
	expect_status 0 diff "${WORK}/expected-isolcpus" "${WORK}/isolcpus"
	host_boot "${LOWLAT_ROOT}" "${WORK}/pristine" >"${WORK}/output" 2>&1
	grep -qx "${cpus}" "${LOWLAT_ROOT}/sys/devices/system/cpu/isolated" || fail "fake kernel kept the flags in its isolated list"
	expect_status 0 "${REPO}/scripts/01-grub-bootloader" --verify
	grep -q "PASS isolcpus=managed_irq,domain,${cpus}$" "${WORK}/output" || fail "the flagged form was not verified"
	# The running kernel still has the flags, so the plain form is a FAIL until the next boot.
	sed -i 's/^GRUB_ISOLCPUS_MANAGED_IRQ=.*/GRUB_ISOLCPUS_MANAGED_IRQ=no/' "${conf}"
	expect_status 5 "${REPO}/scripts/01-grub-bootloader" --verify
	expect_status 0 "${REPO}/scripts/01-grub-bootloader" --apply
	grep -o ' isolcpus=[^ ]*' "${entry}" >"${WORK}/isolcpus"
	printf ' isolcpus=%s\n' "${cpus}" >"${WORK}/expected-isolcpus"
	expect_status 0 diff "${WORK}/expected-isolcpus" "${WORK}/isolcpus"
	expect_status 0 "${REPO}/scripts/01-grub-bootloader" --rollback
	if grep -q 'isolcpus=' "${entry}"; then fail "rollback left isolcpus behind"; fi
	sed -i 's/^GRUB_ISOLCPUS_MANAGED_IRQ=.*/GRUB_ISOLCPUS_MANAGED_IRQ=maybe/' "${conf}"
	cp "${entry}" "${WORK}/entry-before"
	expect_status 3 "${REPO}/scripts/01-grub-bootloader" --apply
	grep -q "GRUB_ISOLCPUS_MANAGED_IRQ must be yes or no, not 'maybe'" "${WORK}/output" || fail "the bad value was not explained"
	expect_status 0 diff "${WORK}/entry-before" "${entry}"
}

