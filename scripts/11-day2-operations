#!/usr/bin/env bash
#
# 11-day2-operations - keep a tuned host tuned (Guide 11).
#
#   install_verify_timer       lowlat-verify.service and lowlat-verify.timer: verify-tuning on
#                              a schedule and ten minutes after every boot, on the OS CPUs
#   all_kernel_entries_isolated   every installed kernel entry carries the isolation arguments
#   verify_day2_operations     timer enabled, last run not failed, kernel entries carry isolcpus
#
# DAY2_VERIFY_TIMER (yes or no) and DAY2_VERIFY_SCHEDULE (a systemd OnCalendar expression)
# come from lowlat.conf. The timer only runs the read-only report: a FAIL makes the unit
# fail, so drift shows up in `systemctl --failed` and in the journal.

set -Eeuo pipefail
# shellcheck source=lib/common
. "$(dirname "${BASH_SOURCE[0]}")/lib/common"

SYSTEMD_UNIT_DIR="${SYSTEMD_UNIT_DIR:-/etc/systemd/system}"
VERIFY_UNIT=lowlat-verify
REPORT_DIR="${LOWLAT_STATE_DIR}/reports"

# day2_defaults - lowlat.conf files written before Guide 11 have no DAY2_* keys.
day2_defaults() {
	DAY2_VERIFY_TIMER="${DAY2_VERIFY_TIMER:-yes}"
	DAY2_VERIFY_SCHEDULE="${DAY2_VERIFY_SCHEDULE:-daily}"
	[[ -n "${OS_CPUS+set}" ]] || OS_CPUS=()
	return 0
}

# unit_quote <text> - quote text for a systemd Environment= or Exec value: backslash, double
# quote and % (a specifier) are escaped, so a path with spaces survives.
unit_quote() {
	local value="$1"
	value="${value//\\/\\\\}"
	value="${value//\"/\\\"}"
	value="${value//%/%%}"
	printf '"%s"\n' "${value}"
}

# remove_verify_timer - stop the timer and remove the units, whether or not an earlier run installed them.
remove_verify_timer() {
	run_quiet systemctl disable --now "${VERIFY_UNIT}.timer"
	run rm -f "${SYSTEMD_UNIT_DIR}/${VERIFY_UNIT}.service" "${SYSTEMD_UNIT_DIR}/${VERIFY_UNIT}.timer"
	run systemctl daemon-reload
	# A failed last run would keep showing up in `systemctl --failed` after the opt-out.
	run_quiet systemctl reset-failed "${VERIFY_UNIT}.service"
}

install_verify_timer() {
	local cpus config config_dir dir=. condition_path env_line exec_bin exec_report exec_line
	day2_defaults
	log_step "Verification timer (DAY2_VERIFY_TIMER=${DAY2_VERIFY_TIMER})"
	if [[ "${DAY2_VERIFY_TIMER}" != yes ]]; then
		log_sub_step "DAY2_VERIFY_TIMER is not yes: no timer, and removing one that an earlier run installed"
		remove_verify_timer
		return 0
	fi
	require_capability day2_operations || return 0
	cpus="${OS_CPUS[*]}"
	config="${LOWLAT_CONFIG}"
	# systemd ignores a relative ConditionPathExists, and the service starts elsewhere: embed an absolute path.
	[[ "${config}" == */* ]] && dir="${config%/*}"
	if config_dir="$(cd "${dir}" 2>/dev/null && pwd -P)"; then
		config="${config_dir}/${config##*/}"
	fi
	condition_path="${config//%/%%}"
	env_line="$(unit_quote "LOWLAT_CONFIG=${config}")"
	exec_bin="$(unit_quote "${LOWLAT_SCRIPTS_DIR}/verify-tuning")"
	exec_report="$(unit_quote "${REPORT_DIR}/verify-latest.txt")"
	exec_line="${exec_bin} --report ${exec_report}"
	log_sub_step "Writing ${VERIFY_UNIT}.service (ExecStart=${LOWLAT_SCRIPTS_DIR}/verify-tuning, CPUs: ${cpus:-any})"
	write_file "${SYSTEMD_UNIT_DIR}/${VERIFY_UNIT}.service" <<EOF
# Managed by mechanical-sympathy 11-day2-operations
[Unit]
Description=Verify the low-latency tuning (read-only report)
ConditionPathExists=${condition_path}
# A missed run that Persistent=true triggers at activation must not inspect runtime state before
# lowlat-runtime.service has re-applied it. Ordering only: no Wants=, so verification never starts
# runtime tuning that the operator disabled.
After=lowlat-runtime.service

[Service]
Type=oneshot
Environment=${env_line}
ExecStartPre=/usr/bin/mkdir -p ${REPORT_DIR}
# verify-tuning exits 5 when a check FAILs, which marks this unit as failed.
ExecStart=${exec_line}
SyslogIdentifier=${VERIFY_UNIT}
Nice=19
IOSchedulingClass=idle
${cpus:+CPUAffinity=${cpus}}
EOF
	log_sub_step "Writing ${VERIFY_UNIT}.timer (${DAY2_VERIFY_SCHEDULE}, and 10 min after every boot)"
	write_file "${SYSTEMD_UNIT_DIR}/${VERIFY_UNIT}.timer" <<EOF
# Managed by mechanical-sympathy 11-day2-operations
[Unit]
Description=Verify the low-latency tuning on a schedule

[Timer]
OnBootSec=10min
OnCalendar=${DAY2_VERIFY_SCHEDULE}
Persistent=true
RandomizedDelaySec=15min

[Install]
WantedBy=timers.target
EOF
	run systemctl daemon-reload
	run systemctl enable --now "${VERIFY_UNIT}.timer"
}

# --- verification (read-only) ------------------------------------------------

# all_kernel_entries_isolated <cpu>... - predicate: every installed kernel entry (the rescue
# entry aside) sets isolcpus, nohz_full and rcu_nocbs to exactly the given CPUs, whether the
# entry writes them as a list or as ranges. False when grubby is missing, fails or lists no
# entry: an entry that cannot be inspected is not known to be tuned.
all_kernel_entries_isolated() {
	local entries want
	want="$(cpu_list_join "$@")"
	command -v grubby >/dev/null 2>&1 || return 1
	entries="$(grubby --info=ALL 2>/dev/null)" || return 1
	[[ -n "${entries}" ]] || return 1
	awk -v want="${want}" '
		function norm(v,    parts, n, i, ab, k, cnt, list, j, t, out) {
			n = split(v, parts, ",")
			cnt = 0
			for (i = 1; i <= n; i++) {
				if (parts[i] ~ /^[0-9]+$/) list[++cnt] = parts[i] + 0
				else if (parts[i] ~ /^[0-9]+-[0-9]+$/) {
					split(parts[i], ab, "-")
					for (k = ab[1] + 0; k <= ab[2] + 0; k++) list[++cnt] = k
				}
			}
			for (i = 2; i <= cnt; i++) {
				t = list[i]
				for (j = i - 1; j >= 1 && list[j] > t; j--) list[j + 1] = list[j]
				list[j + 1] = t
			}
			out = ""
			for (i = 1; i <= cnt; i++) if (i == 1 || list[i] != list[i - 1]) out = out (out == "" ? "" : ",") list[i]
			return out
		}
		function argval(line, name,    m) {
			if (!match(line, "(^|[ \"])" name "=[^ \"]*")) return ""
			m = substr(line, RSTART, RLENGTH)
			sub("^[ \"]", "", m)
			sub("^" name "=", "", m)
			return m
		}
		BEGIN { target = norm(want) }
		/^kernel=/ { rescue = ($0 ~ /rescue/) }
		/^args=/ && !rescue {
			n++
			if (norm(argval($0, "isolcpus")) != target || norm(argval($0, "nohz_full")) != target || norm(argval($0, "rcu_nocbs")) != target) bad++
		}
		END { exit !(n > 0 && bad == 0) }' <<<"${entries}"
}

verify_day2_operations() {
	local report written
	day2_defaults
	if [[ "${DAY2_VERIFY_TIMER}" == yes ]] && host_allows_apply; then
		verify_check "${VERIFY_UNIT}.timer is enabled" systemctl is-enabled --quiet "${VERIFY_UNIT}.timer"
		verify_soft "${VERIFY_UNIT}.timer is active" systemctl is-active --quiet "${VERIFY_UNIT}.timer"
		verify_soft "the last ${VERIFY_UNIT} run did not fail" not systemctl is-failed --quiet "${VERIFY_UNIT}.service"
		report="${REPORT_DIR}/verify-latest.txt"
		if [[ -f "${report}" ]]; then
			written="$(date -r "${report}" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || true)"
			verify_info "latest report: ${report}, written ${written:-n/a}"
		else
			verify_info "no report yet: the timer has not run"
		fi
	else
		verify_info "verification timer not managed here (DAY2_VERIFY_TIMER=${DAY2_VERIFY_TIMER}, host_class=${HOST_CLASS})"
	fi
	if host_is_bare_metal && ((${#ISOLATED_CPUS[@]} > 0)); then
		verify_soft "every installed kernel entry sets isolcpus, nohz_full and rcu_nocbs to ISOLATED_CPUS (WARN also when grubby cannot list them)" all_kernel_entries_isolated "${ISOLATED_CPUS[@]}"
	fi
	verify_result
}

apply_day2_operations() {
	install_verify_timer
}

rollback_day2_operations() {
	day2_defaults
	log_step "Verification timer"
	log_sub_step "Disabling ${VERIFY_UNIT}.timer and removing the units"
	remove_verify_timer
	log_sub_step "Removing the reports"
	run rm -rf "${REPORT_DIR}"
}

main() {
	parse_mode_args "$@" || true
	case "${MODE}" in
	apply)
		require_root
		load_config
		apply_day2_operations
		print_step_timing_table
		;;
	verify)
		load_config
		verify_day2_operations
		;;
	rollback)
		require_root
		load_config
		rollback_day2_operations
		;;
	*) print_usage ;;
	esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
	main "$@"
fi
