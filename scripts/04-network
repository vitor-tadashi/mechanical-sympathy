#!/usr/bin/env bash
#
# 04-network - NIC queue, coalescing, offload and IRQ placement (Guide 04).
#
#   tune_nic_low_latency <iface> <role> [txqueuelen] [irq cpus]  channels, coalescing, pause, offloads, rings
#   set_nic_irq_affinity <iface> <cpu list>           route every IRQ of the NIC to those CPUs
#   show_nic_state <iface>                            one-screen summary of what is configured
#
# Everything here is RUNTIME state: drivers forget it on reboot, link flap or driver
# reload. lowlat-runtime.service re-runs `04-network --runtime` at every boot.

set -Eeuo pipefail
# shellcheck source=lib/common
. "$(dirname "${BASH_SOURCE[0]}")/lib/common"

# nic_field <spec> <index> - fields of a NICS entry "name|role|irq_cpus|txqueuelen".
nic_field() {
	local -a fields
	IFS='|' read -r -a fields <<<"$1"
	printf '%s\n' "${fields[$2]:-}"
}

nic_exists() {
	[[ -d "${LOWLAT_ROOT}/sys/class/net/$1" ]] && return 0
	# Dry-run on a machine without sysfs (e.g. a laptop): pretend, to show the plan.
	[[ "${DRY_RUN}" -eq 1 && ! -d "${LOWLAT_ROOT}"/sys/class/net ]]
}

# A NIC is "bypass" when a kernel-bypass runtime is installed and the NIC uses its driver.
nic_is_kernel_bypass() {
	local iface="$1" driver
	[[ -n "${KERNEL_BYPASS_DRIVER:-}" && -n "${KERNEL_BYPASS_COMMAND:-}" ]] || return 1
	command -v "${KERNEL_BYPASS_COMMAND}" >/dev/null 2>&1 || return 1
	driver="$({ ethtool -i "${iface}" 2>/dev/null || true; } | awk -F': ' '/^driver:/{print $2}')"
	[[ "${driver}" == "${KERNEL_BYPASS_DRIVER}" ]]
}

# ethtool_max <iface> <-l|-g> <label> - first value of <label> in "Pre-set maximums".
ethtool_max() {
	{ ethtool "$2" "$1" 2>/dev/null || true; } | awk -v l="$3:" '$1==l {print $2; exit}'
}

# ethtool_current <iface> <-l|-g> <label> - first value of <label> in "Current hardware settings".
ethtool_current() {
	{ ethtool "$2" "$1" 2>/dev/null || true; } | awk -v l="$3:" '/^Current/ {c = 1} c && $1==l {print $2; exit}'
}

# nic_queue_count <irq cpus> <hardware max> - one combined queue per CPU that services
# the NIC's interrupts. More queues than IRQ CPUs buys no parallelism: the extra queues'
# interrupts land on the same CPUs and only add NAPI contexts, IRQ vectors and memory.
nic_queue_count() {
	local expanded count
	local -a cpu_array
	expanded="$(cpu_list_expand "$1")"
	read -r -a cpu_array <<<"${expanded}"
	count="${#cpu_array[@]}"
	if [[ "$2" =~ ^[0-9]+$ ]] && ((count > $2)); then
		count="$2"
	fi
	printf '%s\n' "${count}"
}

# Settings are restored after channels/rings, which may reset the other knobs.
NIC_SETTINGS=(combined rx_ring tx_ring tso gso lro rx_csum tx_csum pause_autoneg pause_rx pause_tx
	txqueuelen rx_usecs tx_usecs adaptive_rx adaptive_tx)

nic_setting() {
	local iface="$1" key="$2" output label option
	case "${key}" in
	combined) ethtool_current "${iface}" -l Combined; return ;;
	rx_ring) ethtool_current "${iface}" -g RX; return ;;
	tx_ring) ethtool_current "${iface}" -g TX; return ;;
	txqueuelen) read_value "${LOWLAT_ROOT}/sys/class/net/${iface}/tx_queue_len" ""; return ;;
	adaptive_rx | adaptive_tx | rx_usecs | tx_usecs) option=-c ;;
	pause_*) option=-a ;;
	*) option=-k ;;
	esac
	# Unsupported driver queries are represented by an empty value, never a default.
	output="$(ethtool "${option}" "${iface}" 2>/dev/null || true)"
	case "${key}" in
	adaptive_rx) awk '/^Adaptive RX:/ {print $3; exit}' <<<"${output}"; return ;;
	adaptive_tx) awk '/^Adaptive RX:/ {print $5; exit}' <<<"${output}"; return ;;
	rx_usecs) label=rx-usecs ;;
	tx_usecs) label=tx-usecs ;;
	pause_autoneg) label=Autonegotiate ;;
	pause_rx) label=RX ;;
	pause_tx) label=TX ;;
	tso) label=tcp-segmentation-offload ;;
	gso) label=generic-segmentation-offload ;;
	lro) label=large-receive-offload ;;
	rx_csum) label=rx-checksumming ;;
	tx_csum) label=tx-checksumming ;;
	*) die "unknown NIC setting: ${key}" ;;
	esac
	awk -v k="${label}:" '$1 == k {print $2; exit}' <<<"${output}"
}

remember_nic() {
	local iface="$1" tuning="$2" key value irqs irq affinities=""
	[[ "${DRY_RUN}" -eq 1 ]] && return 0
	if [[ -f "${LOWLAT_FACTORY_DIR}/.values/04/${iface}/complete" ]]; then
		value="$(original_value "04/${iface}/irq-affinities")"
		value="$(original_value "04/${iface}/complete")"
		case "${value}" in
		yes)
			value="$(original_value "04/${iface}/settings-complete")"
			[[ "${value}" == yes ]] || die "invalid saved ${iface} settings marker"
			for key in "${NIC_SETTINGS[@]}"; do value="$(original_value "04/${iface}/${key}")"; done
			;;
		no) ;;
		*) die "invalid saved ${iface} apply marker" ;;
		esac
	fi
	if [[ "${tuning}" == yes && ! -f "${LOWLAT_FACTORY_DIR}/.values/04/${iface}/settings-complete" ]]; then
		for key in "${NIC_SETTINGS[@]}"; do
			value="$(nic_setting "${iface}" "${key}")"
			[[ "${value}" != n/a ]] || value=""
			remember_value "04/${iface}/${key}" "${value:-unavailable}"
		done
		remember_value "04/${iface}/settings-complete" yes
	fi
	if [[ "${tuning}" == yes && "${NIC_DISABLE_CSUM_OFFLOAD:-no}" == yes ]]; then
		remember_value "04/${iface}/checksum-managed" yes
	fi
	if [[ ! -f "${LOWLAT_FACTORY_DIR}/.values/04/${iface}/irq-affinities" ]]; then
		irqs="$(nic_irqs "${iface}")"
		irqs="$(sort -n <<<"${irqs}")"
		while read -r irq; do
			[[ -n "${irq}" ]] || continue
			value="$(read_value "${LOWLAT_ROOT}/proc/irq/${irq}/smp_affinity_list" "")"
			[[ -n "${value}" ]] || die "cannot save ${iface} IRQ ${irq} affinity" "${EXIT_PRECHECK}"
			affinities+="${affinities:+$'\n'}${value}"
		done <<<"${irqs}"
		remember_value "04/${iface}/irq-affinities" "${affinities:-unavailable}"
	fi
	remember_value "04/${iface}/complete" "${tuning}"
}

remember_network() {
	local spec iface role cpus tuning
	for spec in "${NICS[@]}"; do
		iface="$(nic_field "${spec}" 0)"
		role="$(nic_field "${spec}" 1)"
		cpus="$(nic_field "${spec}" 2)"
		[[ "${role}" != mgmt || -n "${cpus}" ]] || continue
		nic_exists "${iface}" || continue
		tuning=yes
		[[ "${role}" != mgmt ]] || tuning=no
		remember_nic "${iface}" "${tuning}"
	done
}

# Do not change a setting whose original value the driver cannot report.
change_nic() {
	local iface="$1" keys="$2" key value
	shift 2
	if [[ "${DRY_RUN}" -ne 1 ]]; then
		for key in ${keys}; do
			value="$(original_value "04/${iface}/${key}")"
			if [[ "${value}" == unavailable ]]; then
				log_warn "${iface}: ${key} is unreadable, leaving it unchanged"
				return 0
			fi
		done
	fi
	run_quiet "$@"
}

restore_nic_setting() {
	local iface="$1" key="$2" value current argument
	value="$(original_value "04/${iface}/${key}")"
	[[ "${value}" != unavailable ]] || return 0
	case "${key}" in
	combined | rx_ring | tx_ring | txqueuelen | rx_usecs | tx_usecs)
		[[ "${value}" =~ ^[0-9]+$ ]] || die "invalid saved ${iface} ${key}" ;;
	*) [[ "${value}" == on || "${value}" == off ]] || die "invalid saved ${iface} ${key}" ;;
	esac
	current="$(nic_setting "${iface}" "${key}")"
	[[ "${current}" != "${value}" ]] || return 0
	case "${key}" in
	combined) run ethtool -L "${iface}" combined "${value}" ;;
	rx_ring) run ethtool -G "${iface}" rx "${value}" ;;
	tx_ring) run ethtool -G "${iface}" tx "${value}" ;;
	adaptive_rx | adaptive_tx | rx_usecs | tx_usecs)
		argument="${key//_/-}"
		run ethtool -C "${iface}" "${argument}" "${value}" ;;
	pause_*) run ethtool -A "${iface}" "${key#pause_}" "${value}" ;;
	txqueuelen) run ip link set dev "${iface}" txqueuelen "${value}" ;;
	*) run ethtool -K "${iface}" "${key%_csum}" "${value}" ;;
	esac
}

rollback_network() {
	local state iface key saved irqs irq value index complete
	local -a affinities
	log_step "Restoring NIC settings and IRQ affinity"
	for state in "${LOWLAT_FACTORY_DIR}"/.values/04/*/complete; do
		[[ -f "${state}" ]] || continue
		iface="${state%/complete}"
		iface="${iface##*/}"
		nic_exists "${iface}" || die "cannot restore missing interface ${iface}"
		complete="$(original_value "04/${iface}/complete")"
		[[ "${complete}" == yes || "${complete}" == no ]] || die "invalid saved ${iface} apply marker"
		if [[ "${complete}" == yes ]]; then
			value="$(original_value "04/${iface}/settings-complete")"
			[[ "${value}" == yes ]] || die "invalid saved ${iface} settings marker"
			for key in "${NIC_SETTINGS[@]}"; do
				if [[ "${key}" == *_csum && ! -f "${state%/complete}/checksum-managed" ]]; then continue; fi
				restore_nic_setting "${iface}" "${key}"
			done
		fi
		saved="$(original_value "04/${iface}/irq-affinities")"
		[[ "${saved}" != unavailable ]] || continue
		mapfile -t affinities <<<"${saved}"
		irqs="$(nic_irqs "${iface}")"
		irqs="$(sort -n <<<"${irqs}")"
		index=0
		while read -r irq; do
			[[ -n "${irq}" ]] || continue
			((index < ${#affinities[@]})) || die "${iface}: IRQ vector count changed"
			value="${affinities[index]}"
			[[ "${value}" =~ ^[0-9]+(-[0-9]+)?(,[0-9]+(-[0-9]+)?)*$ ]] || die "invalid saved ${iface} IRQ affinity"
			[[ -e "${LOWLAT_ROOT}/proc/irq/${irq}/smp_affinity_list" ]] || die "cannot restore missing IRQ ${irq} affinity"
			# Kernel-managed IRQs refuse user placement, as they did on apply: warn and go on with the rest.
			sysfs_write "${value}" "${LOWLAT_ROOT}/proc/irq/${irq}/smp_affinity_list" 2>/dev/null ||
				log_warn "${iface}: IRQ ${irq} is kernel-managed, affinity not restored"
			index=$((index + 1))
		done <<<"${irqs}"
		((index == ${#affinities[@]})) || die "${iface}: IRQ vector count changed"
	done
}

# tune_nic_low_latency <iface> <role> [txqueuelen] [irq cpus]
#   role: critical | timing | bulk | mgmt (mgmt interfaces are never touched)
tune_nic_low_latency() {
	local iface="$1" role="$2" txqueuelen="${3:-0}" irq_cpus="${4:-}" usecs=0 combined max_rx max_tx

	if ! nic_exists "${iface}"; then
		log_sub_step "Network interface ${iface} does not exist (or is bound to a user-space driver), skipping"
		return 0
	fi
	if [[ "${role}" == mgmt ]]; then
		log_sub_step "${iface} is a management interface, leaving it untouched"
		return 0
	fi
	[[ "${role}" == bulk ]] && usecs="${NIC_BULK_COALESCE_USECS:-0}"

	# Queues (Guide 04 §5.1). Kernel bypass: the bypass stack has its own queues for the
	# accelerated traffic, so the kernel keeps a single queue for what is left (Guide 08).
	# Kernel stack: one queue per CPU that services the NIC's interrupts.
	if nic_is_kernel_bypass "${iface}"; then
		log_sub_step "${iface}: kernel-bypass NIC, 1 combined queue"
		change_nic "${iface}" combined ethtool -L "${iface}" combined 1
	else
		if [[ -z "${irq_cpus}" ]]; then
			log_sub_step "${iface}: no IRQ CPUs configured, queue count left at the driver default"
		else
			combined="$(ethtool_max "${iface}" -l Combined)"
			combined="$(nic_queue_count "${irq_cpus}" "${combined}")"
			log_sub_step "${iface}: ${combined} combined queue(s), one per IRQ CPU (${irq_cpus})"
			change_nic "${iface}" combined ethtool -L "${iface}" combined "${combined}"
		fi
		# Adaptive coalescing re-tunes rx/tx-usecs on the fly based on load; with it on,
		# the fixed values below are overwritten within milliseconds.
		log_sub_step "${iface}: adaptive-rx off, adaptive-tx off"
		change_nic "${iface}" "adaptive_rx adaptive_tx" ethtool -C "${iface}" adaptive-rx off adaptive-tx off
	fi

	# Interrupt coalescing: 0 = raise the interrupt as soon as a packet is DMA'd
	# (no waiting to batch more packets into one interrupt).
	log_sub_step "${iface}: rx-usecs ${usecs}, tx-usecs ${usecs}"
	change_nic "${iface}" rx_usecs ethtool -C "${iface}" rx-usecs "${usecs}"
	change_nic "${iface}" tx_usecs ethtool -C "${iface}" tx-usecs "${usecs}"

	# Ethernet flow control (IEEE 802.3x PAUSE frames). With it on, a congested peer
	# or switch can pause our transmitter for up to ~3.3 ms at 10G.
	log_sub_step "${iface}: pause frames off (ethtool -A autoneg off rx off tx off)"
	change_nic "${iface}" "pause_autoneg pause_rx pause_tx" ethtool -A "${iface}" autoneg off rx off tx off

	# Segmentation/aggregation offloads batch small packets into large ones (LRO/GRO
	# on receive, TSO/GSO on transmit). Great for throughput, but a small request
	# may wait for its batch.
	log_sub_step "${iface}: tso off, gso off, lro off"
	change_nic "${iface}" "tso gso lro" ethtool -K "${iface}" tso off gso off lro off

	if [[ "${NIC_DISABLE_CSUM_OFFLOAD:-no}" == yes ]]; then
		log_sub_step "${iface}: rx/tx checksum offload off (NIC_DISABLE_CSUM_OFFLOAD=yes)"
		change_nic "${iface}" "rx_csum tx_csum" ethtool -K "${iface}" rx off tx off
	fi

	# Rings at the hardware maximum: absorbs bursts (traffic spikes, reconnect storms)
	# without drops. Latency is not affected when the ring is not backed up.
	max_rx="$(ethtool_max "${iface}" -g RX)"
	max_tx="$(ethtool_max "${iface}" -g TX)"
	if [[ -n "${max_rx}" && "${max_rx}" != n/a ]]; then
		log_sub_step "${iface}: RX ring ${max_rx}"
		change_nic "${iface}" rx_ring ethtool -G "${iface}" rx "${max_rx}"
	fi
	if [[ -n "${max_tx}" && "${max_tx}" != n/a ]]; then
		log_sub_step "${iface}: TX ring ${max_tx}"
		change_nic "${iface}" tx_ring ethtool -G "${iface}" tx "${max_tx}"
	fi

	if [[ "${txqueuelen}" != 0 ]]; then
		log_sub_step "${iface}: txqueuelen ${txqueuelen}"
		run ip link set dev "${iface}" txqueuelen "${txqueuelen}"
	fi
}

# nic_irqs <iface> - IRQ numbers of the NIC. MSI-X vectors of the PCI function first
# (exact, no name matching); /proc/interrupts names as a fallback (virtio, bonds, ...).
nic_irqs() {
	local iface="$1" dir="${LOWLAT_ROOT}/sys/class/net/$1/device/msi_irqs"
	local vector found=0 device
	device="$(readlink -f "${LOWLAT_ROOT}/sys/class/net/${iface}/device" 2>/dev/null || true)"
	if [[ "${device##*/}" =~ ^virtio[0-9]+$ ]]; then
		dir="${device%/*}/msi_irqs"
	fi
	if [[ -d "${dir}" ]]; then
		for vector in "${dir}"/*; do
			[[ -e "${vector}" ]] || continue
			printf '%s\n' "${vector##*/}"
			found=1
		done
		[[ "${found}" -eq 1 ]] && return 0
	fi
	# Match "<iface>" or "<iface>-<suffix>" as a whole word (em1 must not match em10).
	[[ -r "${LOWLAT_ROOT}"/proc/interrupts ]] || return 0
	awk -v n="${iface}" '{ for (i = NF; i > 1; i--) if ($i == n || index($i, n "-") == 1) { sub(":", "", $1); print $1; break } }' \
		"${LOWLAT_ROOT}"/proc/interrupts
}

# set_nic_irq_affinity <iface> <cpu list> - e.g. set_nic_irq_affinity ens1f0 1
set_nic_irq_affinity() {
	local iface="$1" cpus="$2" irq irqs count=0
	if ! nic_exists "${iface}"; then
		log_sub_step "Network interface ${iface} does not exist, skipping"
		return 0
	fi
	[[ -n "${cpus}" ]] || {
		log_warn "${iface}: no IRQ CPUs configured"
		return 0
	}
	log_sub_step "${iface}: routing interrupts to CPUs ${cpus}"
	irqs="$(nic_irqs "${iface}")"
	while read -r irq; do
		[[ -n "${irq}" && -e "${LOWLAT_ROOT}/proc/irq/${irq}/smp_affinity_list" ]] || continue
		if [[ "${DRY_RUN}" -eq 1 ]]; then
			printf '           [dry-run] echo %s > /proc/irq/%s/smp_affinity_list\n' "${cpus}" "${irq}"
		elif ! printf '%s\n' "${cpus}" >"${LOWLAT_ROOT}/proc/irq/${irq}/smp_affinity_list" 2>/dev/null; then
			# Kernel-managed IRQs (some drivers on RHEL 9) refuse user placement.
			log_warn "${iface}: IRQ ${irq} is kernel-managed, affinity not changed"
			continue
		fi
		count=$((count + 1))
	done <<<"${irqs}"
	log_sub_step "${iface}: ${count} IRQ(s) placed"
}

show_nic_state() {
	local iface="$1" irq irqs driver numa_node value
	driver="$({ ethtool -i "${iface}" 2>/dev/null || true; } | awk -F': ' '/^driver:/{print $2}')"
	numa_node="$(read_value "${LOWLAT_ROOT}/sys/class/net/${iface}/device/numa_node")"
	printf '== %s (%s) numa_node=%s\n' "${iface}" "${driver:-n/a}" "${numa_node}"
	ethtool -l "${iface}" 2>/dev/null | awk '/Current/{c=1} c && /Combined/{print "   queues:   " $2; exit}' || true
	ethtool -c "${iface}" 2>/dev/null | awk '/^Adaptive|^rx-usecs:|^tx-usecs:/{printf "   %s", $0; print ""}' || true
	ethtool -a "${iface}" 2>/dev/null | awk '/^(Autonegotiate|RX|TX):/{printf "   pause %s\n", $0}' || true
	ethtool -k "${iface}" 2>/dev/null | awk '/^(tcp-segmentation-offload|generic-segmentation-offload|large-receive-offload|generic-receive-offload|rx-checksumming|tx-checksumming):/{printf "   %s\n", $0}' || true
	ethtool -g "${iface}" 2>/dev/null | awk '/Current/{c=1} c && /^(RX|TX):/{printf "   ring %s\n", $0}' || true
	value="$(read_value "${LOWLAT_ROOT}/sys/class/net/${iface}/tx_queue_len")"
	printf '   txqueuelen: %s\n' "${value}"
	irqs="$(nic_irqs "${iface}")"
	while read -r irq; do
		[[ -n "${irq}" ]] || continue
		value="$(read_value "${LOWLAT_ROOT}/proc/irq/${irq}/smp_affinity_list")"
		printf '   irq %-5s -> %s\n' "${irq}" "${value}"
	done <<<"${irqs}"
}

apply_network() {
	local spec iface role cpus txq
	remember_network
	log_step "NIC queues, coalescing, pause frames, offloads and rings"
	if require_capability nic_tuning; then
		require_commands ethtool ip
		for spec in "${NICS[@]}"; do
			iface="$(nic_field "${spec}" 0)"
			role="$(nic_field "${spec}" 1)"
			cpus="$(nic_field "${spec}" 2)"
			txq="$(nic_field "${spec}" 3)"
			tune_nic_low_latency "${iface}" "${role}" "${txq:-0}" "${cpus}"
		done
	fi

	log_step "NIC interrupt affinity"
	if require_capability nic_irq_affinity; then
		if host_is_vm && systemctl is-active --quiet irqbalance 2>/dev/null; then
			log_warn "irqbalance is running on this VM and will move these IRQs again"
		fi
		for spec in "${NICS[@]}"; do
			iface="$(nic_field "${spec}" 0)"
			role="$(nic_field "${spec}" 1)"
			cpus="$(nic_field "${spec}" 2)"
			[[ "${role}" == mgmt && -z "${cpus}" ]] && continue
			set_nic_irq_affinity "${iface}" "${cpus}"
		done
	fi
}

# --- verification -----------------------------------------------------------

coalesce_is() { # coalesce_is <iface> <key> <value>
	local actual
	actual="$({ ethtool -c "$1" 2>/dev/null || true; } | awk -v k="$2:" '$1==k {print $2; exit}')"
	[[ "${actual}" == "$3" ]]
}

queues_are() { # queues_are <iface> <count>
	local actual
	actual="$(ethtool_current "$1" -l Combined)"
	[[ "${actual}" == "$2" ]]
}

adaptive_rx_off() {
	local output
	output="$(ethtool -c "$1" 2>/dev/null)" || return 1
	grep -q '^Adaptive RX: off' <<<"${output}"
}

irqs_on_cpus() { # irqs_on_cpus <iface> <cpu list>
	local irq irqs want actual effective cpu count=0
	want="$(cpu_list_expand "$2")"
	irqs="$(nic_irqs "$1")"
	while read -r irq; do
		[[ -n "${irq}" ]] || continue
		actual="$(read_value "${LOWLAT_ROOT}/proc/irq/${irq}/smp_affinity_list" "")"
		[[ -n "${actual}" ]] || return 1
		actual="$(cpu_list_expand "${actual}")"
		[[ "${actual}" == "${want}" ]] || return 1
		if [[ -e "${LOWLAT_ROOT}/proc/irq/${irq}/effective_affinity_list" ]]; then
			effective="$(read_value "${LOWLAT_ROOT}/proc/irq/${irq}/effective_affinity_list" "")"
			[[ -n "${effective}" ]] || return 1
			effective="$(cpu_list_expand "${effective}")"
			for cpu in ${effective}; do
				[[ " ${want} " == *" ${cpu} "* ]] || return 1
			done
		fi
		count=$((count + 1))
	done <<<"${irqs}"
	((count > 0))
}

no_nic_irq_on_isolated_cpus() {
	local spec iface irq irqs cpu effective
	for spec in "${NICS[@]}"; do
		iface="$(nic_field "${spec}" 0)"
		nic_exists "${iface}" || continue
		irqs="$(nic_irqs "${iface}")"
		while read -r irq; do
			[[ -n "${irq}" ]] || continue
			effective="$(read_value "${LOWLAT_ROOT}/proc/irq/${irq}/effective_affinity_list" "")"
			effective="$(cpu_list_expand "${effective}")"
			for cpu in ${effective}; do
				[[ " ${ISOLATED_CPUS[*]} " == *" ${cpu} "* ]] && return 1
			done
		done <<<"${irqs}"
	done
	return 0
}

verify_network() {
	local spec iface role cpus usecs queues
	for spec in "${NICS[@]}"; do
		iface="$(nic_field "${spec}" 0)"
		role="$(nic_field "${spec}" 1)"
		cpus="$(nic_field "${spec}" 2)"
		if ! nic_exists "${iface}"; then
			verify_info "${iface} (${role}) not present"
			continue
		fi
		[[ "${role}" == mgmt ]] && continue
		usecs=0
		[[ "${role}" == bulk ]] && usecs="${NIC_BULK_COALESCE_USECS:-0}"
		verify_check "${iface} (${role}) rx-usecs=${usecs}" coalesce_is "${iface}" rx-usecs "${usecs}"
		verify_soft "${iface} (${role}) adaptive RX off" adaptive_rx_off "${iface}"
		if [[ -n "${cpus}" ]] && ! nic_is_kernel_bypass "${iface}"; then
			queues="$(ethtool_max "${iface}" -l Combined)"
			queues="$(nic_queue_count "${cpus}" "${queues}")"
			verify_soft "${iface} (${role}) ${queues} combined queue(s)" queues_are "${iface}" "${queues}"
		fi
		if [[ -n "${cpus}" ]]; then
			verify_check "${iface} (${role}) IRQs on CPUs ${cpus}" irqs_on_cpus "${iface}" "${cpus}"
		fi
	done
	if host_is_bare_metal; then
		verify_check "no NIC IRQ effective on an isolated CPU" no_nic_irq_on_isolated_cpus
	fi
	verify_result
}

main() {
	parse_mode_args "$@" || true
	case "${MODE}" in
	apply | runtime)
		require_root
		load_config
		apply_network
		;;
	rollback)
		require_root
		load_config
		rollback_network
		;;
	verify)
		load_config
		verify_network
		;;
	*) print_usage ;;
	esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
	main "$@"
fi
