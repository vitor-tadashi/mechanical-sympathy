#!/usr/bin/env bash
#
# 07-os-hygiene - remove background noise from the operating system (Guide 07).
#
#   disable_unnecessary_services   stop + disable services from DISABLE_SERVICES
#   ensure_rsyslog                 keep local logging on (it is cheap and you need it)
#   set_security_limits            limits.d file for the application user/group
#   set_noatime_mounts             noatime on local ext4/xfs filesystems (fstab + remount)
#   install_tuned_profile          custom tuned profile including network-latency
#   flush_firewall_rules           OPT-IN: empty iptables/nftables rule sets
#   remove_netfilter_modules       OPT-IN: unload netfilter/conntrack modules
#
# The two opt-in functions remove host-level packet filtering. Read Guide 07 §6 first.

set -Eeuo pipefail
# shellcheck source=lib/common
. "$(dirname "${BASH_SOURCE[0]}")/lib/common"

LIMITS_FILE="${LIMITS_FILE:-${LOWLAT_ROOT}/etc/security/limits.d/90-lowlat.conf}"
# RHEL 10 moved both vendor and administrator profiles into profiles/.
TUNED_PROFILE_BASE="${LOWLAT_ROOT}/etc/tuned"
if [[ -r "${LOWLAT_ROOT}/etc/os-release" ]] && grep -Eq '^VERSION_ID="?10([."]|$)' "${LOWLAT_ROOT}/etc/os-release"; then
	TUNED_PROFILE_BASE+="/profiles"
fi
TUNED_PROFILE_DIR="${TUNED_PROFILE_DIR:-${TUNED_PROFILE_BASE}/low-latency}"
FSTAB="${FSTAB:-${LOWLAT_ROOT}/etc/fstab}"

# Netfilter modules unloaded by remove_netfilter_modules, in dependency order.
NETFILTER_MODULES=(
	ipt_SYNPROXY nf_synproxy_core xt_CT
	nf_conntrack_ftp nf_conntrack_tftp nf_conntrack_irc nf_nat_tftp
	ipt_MASQUERADE iptable_nat xt_state xt_conntrack
	iptable_raw iptable_filter iptable_mangle ipt_REJECT xt_CHECKSUM
	ip_tables ip6t_REJECT ip6_tables xt_LOG xt_multiport
)

# Save all originals before stopping services; firewalld can discard rules on stop.
remember_os_runtime() {
	local rules modules="" module key value
	[[ "${DRY_RUN}" -eq 1 ]] && return 0
	if [[ "${FLUSH_FIREWALL_RULES:-no}" == yes || "${DISABLE_FIREWALLD:-no}" == yes || "${REMOVE_NETFILTER_MODULES:-no}" == yes ]]; then
		if [[ -f "${LOWLAT_FACTORY_DIR}/.values/07/firewall" ]]; then
			for key in nft iptables ip6tables; do value="$(original_value "07/${key}")"; done
		else
			require_commands nft iptables-save ip6tables-save iptables-restore ip6tables-restore
			rules="$(nft list ruleset)"
			remember_value 07/nft "${rules}"
			rules="$(iptables-save)"
			remember_value 07/iptables "${rules}"
			rules="$(ip6tables-save)"
			remember_value 07/ip6tables "${rules}"
			remember_value 07/firewall yes
		fi
	fi
	if [[ "${REMOVE_NETFILTER_MODULES:-no}" == yes ]]; then
		if [[ -f "${LOWLAT_FACTORY_DIR}/.values/07/modules-complete" ]]; then
			value="$(original_value 07/modules)"
		else
			require_commands modprobe
			for module in "${NETFILTER_MODULES[@]}"; do
				if grep -q "^${module} " "${LOWLAT_ROOT}/proc/modules"; then
					modules+="${modules:+$'\n'}${module}"
				fi
			done
			remember_value 07/modules "${modules}"
			remember_value 07/modules-complete yes
		fi
	fi
}

remember_os_hygiene() {
	local file files unit services="" mounts="" mountpoint options profile value
	[[ "${DRY_RUN}" -eq 1 ]] && return 0
	remember_os_runtime
	if [[ -f "${LOWLAT_FACTORY_DIR}/.values/07/complete" ]]; then
		value="$(original_value 07/complete)"
		[[ "${value}" == yes ]] || die "invalid saved OS hygiene apply marker"
		files="$(original_value 07/files)"
		[[ -n "${files}" ]] || die "empty saved OS hygiene file list"
		while IFS= read -r file; do remember_file "${file}"; done <<<"${files}"
		services="$(original_value 07/services)"
		while IFS= read -r unit; do value="$(original_value "services/${unit}")"; done <<<"${services}"
		if grep -qx tuned <<<"${services}"; then value="$(original_value 07/tuned-profile)"; fi
		mounts="$(original_value 07/mounts)"
		while IFS= read -r mountpoint; do
			[[ -n "${mountpoint}" ]] || continue
			value="$(original_value "07/mount-options${mountpoint%/}/options")"
		done <<<"${mounts}"
		return 0
	fi
	files="${LIMITS_FILE}"$'\n'"${FSTAB}"
	for unit in "${DISABLE_SERVICES[@]}" rsyslog; do
		remember_service "${unit}"
		services+="${services:+$'\n'}${unit}"
	done
	if [[ "${DISABLE_FIREWALLD:-no}" == yes ]]; then
		remember_service firewalld
		services+=$'\n'firewalld
	fi
	if command -v tuned-adm >/dev/null 2>&1; then
		files+=$'\n'"${TUNED_PROFILE_DIR}/tuned.conf"$'\n'"${LOWLAT_ROOT}/etc/tuned/tuned-main.conf"$'\n'"${LOWLAT_ROOT}/etc/tuned/active_profile"$'\n'"${LOWLAT_ROOT}/etc/tuned/profile_mode"$'\n'"${LOWLAT_ROOT}/etc/tuned/bootcmdline"
		remember_service tuned
		services+=$'\n'"tuned"
		if [[ ! -f "${LOWLAT_FACTORY_DIR}/.values/07/tuned-profile" ]]; then
			profile="$(tuned-adm active 2>/dev/null || true)"
			profile="$(sed -n 's/^Current active profile: //p' <<<"${profile}")"
			remember_value 07/tuned-profile "${profile:-off}"
		fi
	fi
	while IFS= read -r file; do remember_file "${file}"; done <<<"${files}"
	remember_value 07/files "${files}"
	remember_value 07/services "${services}"
	if [[ ! -f "${LOWLAT_FACTORY_DIR}/.values/07/mounts" ]]; then
		if [[ -r "${FSTAB}" ]]; then
			mounts="$(awk '!/^[[:space:]]*#/ && ($3=="xfs"||$3=="ext4"||$3=="ext3") && $4 !~ /(^|,)noatime(,|$)/ {print $2}' "${FSTAB}")"
			while IFS= read -r mountpoint; do
				[[ -n "${mountpoint}" ]] || continue
				options="$(findmnt -nro OPTIONS --target "${LOWLAT_ROOT}${mountpoint}")"
				[[ -n "${options}" && "${options}" != *$'\n'* ]] || die "cannot save mount options for ${mountpoint}" "${EXIT_PRECHECK}"
				remember_value "07/mount-options${mountpoint%/}/options" "${options}"
			done <<<"${mounts}"
		fi
		remember_value 07/mounts "${mounts}"
	fi
	remember_value 07/complete yes
}

rollback_os_runtime() {
	local module modules rules
	if [[ -f "${LOWLAT_FACTORY_DIR}/.values/07/modules-complete" ]]; then
		modules="$(original_value 07/modules)"
		# Reload dependencies first, reversing the removal order.
		local -a loaded
		mapfile -t loaded <<<"${modules}"
		for ((module = ${#loaded[@]} - 1; module >= 0; module--)); do
			[[ -n "${loaded[module]}" ]] || continue
			[[ " ${NETFILTER_MODULES[*]} " == *" ${loaded[module]} "* ]] || die "invalid saved netfilter module"
			run modprobe "${loaded[module]}"
		done
	fi
	if [[ -f "${LOWLAT_FACTORY_DIR}/.values/07/firewall" ]]; then
		rules="$(original_value 07/nft)"
		# nft's saved listing is a complete ruleset, not an incremental update.
		run nft flush ruleset
		printf '%s\n' "${rules}" | nft -f -
		rules="$(original_value 07/iptables)"
		printf '%s\n' "${rules}" | iptables-restore
		rules="$(original_value 07/ip6tables)"
		printf '%s\n' "${rules}" | ip6tables-restore
	fi
}

rollback_os_hygiene() {
	local complete files services file unit profile mounts mountpoint options
	log_step "Restoring OS hygiene baseline"
	if [[ -f "${LOWLAT_FACTORY_DIR}/.values/07/complete" ]]; then
		complete="$(original_value 07/complete)"
		[[ "${complete}" == yes ]] || die "invalid saved OS hygiene apply marker"
		files="$(original_value 07/files)"
		[[ -n "${files}" ]] || die "empty saved OS hygiene file list"
		services="$(original_value 07/services)"
		mounts="$(original_value 07/mounts)"
		if grep -qx tuned <<<"${services}"; then
			profile="$(original_value 07/tuned-profile)"
			[[ "${profile}" =~ ^[a-zA-Z0-9_./+-]+(\ [a-zA-Z0-9_./+-]+)*$ ]] || die "invalid saved tuned profile"
			run tuned-adm off
		fi
		while IFS= read -r file; do
			[[ -n "${file}" ]] || continue
			restore_file "${file}"
		done <<<"${files}"
		if [[ -n "${profile:-}" && "${profile}" != off ]]; then run tuned-adm profile "${profile}"; fi
		# Switching profiles also changes tuned's selection files. Restore exact originals.
		if [[ -n "${profile:-}" ]]; then
			restore_file "${LOWLAT_ROOT}/etc/tuned/active_profile"
			restore_file "${LOWLAT_ROOT}/etc/tuned/profile_mode"
		fi
		while IFS= read -r mountpoint; do
			[[ -n "${mountpoint}" ]] || continue
			options="$(original_value "07/mount-options${mountpoint%/}/options")"
			[[ -n "${options}" && "${options}" != *$'\n'* ]] || die "invalid saved mount options"
			run mount -o "remount,${options}" "${LOWLAT_ROOT}${mountpoint}"
		done <<<"${mounts}"
		run systemctl daemon-reload
		rollback_os_runtime
		while IFS= read -r unit; do
			[[ -n "${unit}" ]] || continue
			restore_service "${unit}"
		done <<<"${services}"
		if [[ -n "${profile:-}" ]]; then
			restore_file "${LOWLAT_ROOT}/etc/tuned/bootcmdline"
		fi
		return 0
	fi
	rollback_os_runtime
}

disable_unnecessary_services() {
	local unit
	for unit in "${DISABLE_SERVICES[@]}"; do
		if [[ "${DRY_RUN}" -ne 1 ]] && ! systemctl cat "${unit}" >/dev/null 2>&1; then
			continue
		fi
		log_sub_step "Stopping and disabling ${unit}"
		run_quiet systemctl stop "${unit}"
		run_quiet systemctl disable "${unit}"
	done
	if [[ "${DISABLE_FIREWALLD:-no}" == yes ]]; then
		log_sub_step "Stopping and disabling firewalld (DISABLE_FIREWALLD=yes)"
		run_quiet systemctl stop firewalld
		run_quiet systemctl disable firewalld
	fi
}

ensure_rsyslog() {
	log_sub_step "Enabling rsyslog"
	run_quiet systemctl enable --now rsyslog
}

set_security_limits() {
	log_sub_step "Writing ${LIMITS_FILE} for @${APP_GROUP}"
	write_file "${LIMITS_FILE}" <<EOF
# Managed by mechanical-sympathy 07-os-hygiene
# Applies to login sessions (PAM). systemd services use LimitXXX= in the unit instead.
@${APP_GROUP}  soft  nproc    ${NPROC_LIMIT}
@${APP_GROUP}  hard  nproc    ${NPROC_LIMIT}
@${APP_GROUP}  soft  nofile   ${NOFILE_LIMIT}
@${APP_GROUP}  hard  nofile   ${NOFILE_LIMIT}
# SCHED_FIFO/RR up to this priority without root
@${APP_GROUP}  -     rtprio   ${REAL_TIME_PRIORITY}
# may renice down to -20
@${APP_GROUP}  -     nice     -20
# mlockall() of the whole process (huge pages do not need it, the rest of the process does)
@${APP_GROUP}  -     memlock  unlimited
EOF
}

# Adds noatime to local ext4/xfs entries that do not have it yet. Every read of a file
# otherwise turns into a metadata write (atime update) - journal I/O from a read path.
set_noatime_mounts() {
	local current updated mountpoint mountpoints
	[[ -r "${FSTAB}" ]] || {
		log_warn "${FSTAB} not readable"
		return 0
	}
	updated="$(awk '
		/^[[:space:]]*#/ || NF < 4 { print; next }
		($3 == "xfs" || $3 == "ext4" || $3 == "ext3") && $4 !~ /(^|,)noatime(,|$)/ {
			$4 = ($4 == "defaults") ? "defaults,noatime" : $4 ",noatime"
			print; next
		}
		{ print }' "${FSTAB}")"
	current="$(<"${FSTAB}")"
	if [[ "${updated}" == "${current}" ]]; then
		log_sub_step "${FSTAB}: all local ext4/xfs mounts already use noatime"
		return 0
	fi
	log_sub_step "Adding noatime to local ext4/xfs mounts in ${FSTAB}"
	printf '%s\n' "${updated}" | write_file "${FSTAB}"
	mountpoints="$(awk '!/^[[:space:]]*#/ && ($3=="xfs"||$3=="ext4"||$3=="ext3") {print $2}' "${FSTAB}")"
	while read -r mountpoint; do
		[[ -n "${mountpoint}" ]] || continue
		log_sub_step "Remounting ${mountpoint} with noatime"
		run_quiet mount -o remount,noatime "${LOWLAT_ROOT}${mountpoint}"
	done <<<"${mountpoints}"
}

# A custom profile that inherits network-latency (-> latency-performance): performance
# governor, C-state latency cap via PM QoS, THP off, busy polling, NUMA balancing off.
# tuned applies its [sysctl] section and then (reapply_sysctl=1, the default) re-applies
# /etc/sysctl.d, so the values from Guide 06 win on any conflict.
install_tuned_profile() {
	log_sub_step "Writing ${TUNED_PROFILE_DIR}/tuned.conf (include=${TUNED_BASE_PROFILE})"
	write_file "${TUNED_PROFILE_DIR}/tuned.conf" <<EOF
# Managed by mechanical-sympathy 07-os-hygiene
[main]
summary=Low latency: ${TUNED_BASE_PROFILE} + mechanical-sympathy host settings
include=${TUNED_BASE_PROFILE}

[cpu]
governor=performance
energy_perf_bias=performance
min_perf_pct=100
EOF
	log_sub_step "Making sure tuned re-applies /etc/sysctl.d after its own sysctls"
	if [[ -f "${LOWLAT_ROOT}"/etc/tuned/tuned-main.conf ]] && grep -q '^reapply_sysctl *= *0' "${LOWLAT_ROOT}"/etc/tuned/tuned-main.conf; then
		backup_file "${LOWLAT_ROOT}"/etc/tuned/tuned-main.conf
		run sed -i 's/^reapply_sysctl *= *0/reapply_sysctl = 1/' "${LOWLAT_ROOT}"/etc/tuned/tuned-main.conf
	fi
	log_sub_step "Activating tuned profile low-latency"
	run_quiet systemctl enable --now tuned
	run tuned-adm profile low-latency
}

flush_firewall_rules() {
	if command -v nft >/dev/null 2>&1 || [[ "${DRY_RUN}" -eq 1 ]]; then
		log_sub_step "Flushing nftables ruleset"
		run_quiet nft flush ruleset
	fi
	log_sub_step "Flushing iptables/ip6tables rules and user chains, policies ACCEPT"
	local table
	for table in filter nat mangle raw; do
		run_quiet iptables -t "${table}" -F
		run_quiet iptables -t "${table}" -X
	done
	run_quiet ip6tables -F
	run_quiet ip6tables -X
	run_quiet iptables -P INPUT ACCEPT
	run_quiet iptables -P FORWARD ACCEPT
	run_quiet iptables -P OUTPUT ACCEPT
}

remove_netfilter_modules() {
	local module
	for module in "${NETFILTER_MODULES[@]}"; do
		if [[ "${DRY_RUN}" -ne 1 ]] && ! grep -q "^${module} " "${LOWLAT_ROOT}"/proc/modules; then
			continue
		fi
		log_sub_step "Unloading ${module}"
		run_quiet modprobe -r "${module}"
	done
}

apply_os_hygiene() {
	remember_os_hygiene
	log_step "Unnecessary services"
	if require_capability os_hygiene; then
		disable_unnecessary_services
	fi
	ensure_rsyslog

	log_step "Resource limits for ${APP_USER}"
	set_security_limits

	log_step "noatime on local filesystems"
	set_noatime_mounts

	log_step "tuned profile"
	if command -v tuned-adm >/dev/null 2>&1 || [[ "${DRY_RUN}" -eq 1 ]]; then
		install_tuned_profile
	else
		log_warn "tuned is not installed (dnf install tuned)"
	fi

	log_step "Host packet filtering (opt-in)"
	if [[ "${FLUSH_FIREWALL_RULES:-no}" == yes ]]; then
		flush_firewall_rules
	else
		log_sub_step "FLUSH_FIREWALL_RULES=no, keeping firewall rules"
	fi
	if [[ "${REMOVE_NETFILTER_MODULES:-no}" == yes ]]; then
		remove_netfilter_modules
	else
		log_sub_step "REMOVE_NETFILTER_MODULES=no, keeping netfilter modules"
	fi
}

# Firewall flush and module removal are not persistent; re-done at boot when opted in.
apply_os_hygiene_runtime() {
	remember_os_runtime
	log_step "Host packet filtering (opt-in)"
	[[ "${FLUSH_FIREWALL_RULES:-no}" == yes ]] && flush_firewall_rules
	[[ "${REMOVE_NETFILTER_MODULES:-no}" == yes ]] && remove_netfilter_modules
	return 0
}

service_inactive() { not systemctl is-active --quiet "$1"; }

verify_os_hygiene() {
	local unit rules tables
	for unit in "${DISABLE_SERVICES[@]}"; do
		systemctl cat "${unit}" >/dev/null 2>&1 || continue
		verify_soft "${unit} not running" service_inactive "${unit}"
	done
	verify_check "rsyslog running" systemctl is-active --quiet rsyslog
	verify_check "${LIMITS_FILE} exists" test -f "${LIMITS_FILE}"
	verify_check "tuned profile low-latency active" sh -c 'tuned-adm active | grep -q "low-latency"'
	verify_soft "local ext4/xfs mounted with noatime" sh -c \
		"! findmnt -rn -t xfs,ext4 -o OPTIONS | grep -v noatime | grep -q ."
	rules="$({ iptables -S 2>/dev/null || true; } | grep -vc '^-P' || true)"
	tables="$({ nft list tables 2>/dev/null || true; } | wc -l | tr -d ' ')"
	verify_info "iptables rules: ${rules}, nft tables: ${tables}"
	verify_result
}

main() {
	parse_mode_args "$@" || true
	case "${MODE}" in
	apply)
		require_root
		load_config
		apply_os_hygiene
		;;
	runtime)
		require_root
		load_config
		apply_os_hygiene_runtime
		;;
	rollback)
		require_root
		load_config
		rollback_os_hygiene
		;;
	verify)
		load_config
		verify_os_hygiene
		;;
	*) print_usage ;;
	esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
	main "$@"
fi
