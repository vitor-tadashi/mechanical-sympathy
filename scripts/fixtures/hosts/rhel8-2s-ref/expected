             | #!/bin/bash
             | # Managed by mechanical-sympathy 03-huge-pages - reserves 2M huge pages per NUMA node.
             | nodes_path=/sys/devices/system/node
             | if [[ ! -d ${nodes_path} ]]; then
             | 	echo "ERROR: ${nodes_path} does not exist" >&2
             | 	exit 1
             | fi
             | 
             | reserve_pages() {
             | 	local wanted="$1" node="$2" file got
             | 	file="${nodes_path}/${node}/hugepages/hugepages-2048kB/nr_hugepages"
             | 	if [[ ! -w "${file}" ]]; then
             | 		echo "WARN: ${file} not writable (node missing?)" >&2
             | 		return 0
             | 	fi
             | 	echo "${wanted}" >"${file}"
             | 	got="$(cat "${file}")"
             | 	echo "${node}: requested ${wanted} x 2M, reserved ${got}"
             | 	[[ "${got}" -ge "${wanted}" ]] || echo "WARN: ${node} short by $((wanted - got)) pages (fragmentation?)" >&2
             | }
             | 
             | reserve_pages 2048 node0
             | reserve_pages 12288 node1
