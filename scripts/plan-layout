#!/usr/bin/env bash
#
# plan-layout - propose, or check, the CPU layout of lowlat.conf from the host topology.
#
#   plan-layout --threads N (--nic-node N | --nic IFACE) [--spares N] [--lscpu FILE]
#   plan-layout --check CONF (--nic-node N | --nic IFACE) [--lscpu FILE]
#
# Propose mode reads `lscpu -b -e=CPU,NODE,SOCKET,CORE` (online CPUs, from this host, or from --lscpu FILE)
# and prints an ISOLATED_CPUS / OS_CPUS / WORKQUEUE_CPUS / HOUSEKEEPING_* block that follows
# Guide 02 section 3:
#   1. with a second NUMA node to run the OS, every core of the critical NIC's node is
#      isolated except one housekeeping core (the core of CPU 0 when the NIC is on node 0,
#      otherwise the first core of the node). On a single node, only --threads plus
#      --spares cores are isolated and the rest stay with the OS;
#   2. that core takes the critical NIC's interrupts, so the node keeps one non-isolated core;
#   3. CPU 0 is never isolated;
#   4. Hyper-Threading siblings always share a role: a core is isolated as a whole;
#   5. --threads plus --spares (default 2) isolated cores must exist, or the script refuses.
# The first two OS cores outside the housekeeping core take workqueues, and the next two
# take the agents slice, each with all its Hyper-Threading siblings.
#
# Check mode sources CONF, and reports PASS or FAIL for the four rules above plus NUMA
# locality. It exits 5 (EXIT_VERIFY) when a rule fails.
#
# Not proven in production: the proposal is a starting point for the owner to review.

set -Eeuo pipefail
SCRIPTS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

# shellcheck source=lib/common
. "${SCRIPTS_DIR}/lib/common"

# One awk program computes the layout and checks it. The same rules are written in
# site/layout.js for the explorer, and tools/check-plan-layout keeps them in step.
plan_awk() {
	cat <<'AWK'
function sort_nums(a, n,    i, j, t) {
	for (i = 2; i <= n; i++) {
		t = a[i]
		for (j = i - 1; j >= 1 && a[j] > t; j--) a[j + 1] = a[j]
		a[j + 1] = t
	}
}
function join(a, n, sep,    i, s) {
	s = ""
	for (i = 1; i <= n; i++) s = s (i > 1 ? sep : "") a[i]
	return s
}
function words(s, a,    n) {
	n = split(s, a, /[ ,]+/)
	if (n > 0 && a[1] == "") { for (i = 1; i < n; i++) a[i] = a[i + 1]; n-- }
	return n
}
$1 ~ /^[0-9]+$/ {
	cpu = $1 + 0
	node = ($2 ~ /^[0-9]+$/) ? $2 + 0 : 0
	core = $4 + 0
	ncpu++
	all[ncpu] = cpu
	cpuNode[cpu] = node
	cpuCore[cpu] = core
	coreNode[core] = node
	coreSize[core]++
	if (!(core in coreMin) || cpu < coreMin[core]) coreMin[core] = cpu
	if (!($3 in seenSocket)) { seenSocket[$3] = 1; nsockets++ }
	if (!(node in seenNode)) { seenNode[node] = 1; nnodes++ }
	if (!(core in seenCore)) { seenCore[core] = 1; ncores++ }
	if (coreSize[core] > 1) ht = 1
	next
}
END {
	if (ncpu == 0) { print "no CPU rows found in the topology" > "/dev/stderr"; exit 2 }
	sort_nums(all, ncpu)
	if (!(nic in seenNode)) { printf "NUMA node %s is not in the topology\n", nic > "/dev/stderr"; exit 2 }
	htname = ht ? "on" : "off"
	if (mode == "check") { check(); exit rc }
	propose()
}
function propose(    n, i, j, c, cores, nc, hk, hkcore, isol, niso, os, nos, wq, nwq, ag, nag, need, avail, t, irq, hkcpus, nhk, cand, ncand, spare) {
	# cores of the NIC's node, ordered by their lowest CPU
	nc = 0
	for (c in coreNode) if (coreNode[c] == nic) cores[++nc] = coreMin[c] SUBSEP c
	for (i = 1; i <= nc; i++) { split(cores[i], t, SUBSEP); key[i] = t[1] + 0; id[i] = t[2] + 0 }
	for (i = 2; i <= nc; i++) {
		k = key[i]; d = id[i]
		for (j = i - 1; j >= 1 && key[j] > k; j--) { key[j + 1] = key[j]; id[j + 1] = id[j] }
		key[j + 1] = k; id[j + 1] = d
	}
	# housekeeping core: the core of CPU 0 if it is on this node, else the first core
	hkcore = id[1]
	if (cpuNode[0] == nic) hkcore = cpuCore[0]
	avail = nc - 1
	need = threads + spares
	if (threads < 1) { print "--threads must be at least 1" > "/dev/stderr"; exit 2 }
	if (avail < need) {
		printf "NUMA node %s has %d core(s) besides the housekeeping core, and %d are needed (%d threads + %d spare)\n", nic, avail, need, threads, spares > "/dev/stderr"
		exit 1
	}
	# With a second node, the whole NIC node except the housekeeping core is isolated and
	# the other node runs the OS. On a single node, only the cores that are needed are.
	chosen = 0
	for (i = 1; i <= nc; i++) {
		if (id[i] == hkcore) continue
		if (nnodes > 1 || chosen < need) { isoCore[id[i]] = 1; chosen++ }
	}
	niso = 0; nos = 0
	for (i = 1; i <= ncpu; i++) {
		c = all[i]
		if (cpuCore[c] in isoCore) isol[++niso] = c
		else os[++nos] = c
	}
	nhk = 0
	for (i = 1; i <= ncpu; i++) if (cpuCore[all[i]] == hkcore) hkcpus[++nhk] = all[i]
	irq = hkcpus[1]
	# OS cores outside the housekeeping core, ordered by their lowest CPU. Roles go to whole
	# cores, so that Hyper-Threading siblings never split between two of them.
	ncc = 0
	for (i = 1; i <= nos; i++) {
		c = os[i]
		if (cpuCore[c] == hkcore || (cpuCore[c] in seenCC)) continue
		seenCC[cpuCore[c]] = 1
		ccore[++ncc] = cpuCore[c]
	}
	if (ncc < 3) { printf "only %d OS core(s) outside the housekeeping core, at least 3 are needed for workqueues and agents\n", ncc > "/dev/stderr"; exit 1 }
	for (i = 1; i <= ncc && i <= 4; i++) roleCore[ccore[i]] = (i <= 2) ? "wq" : "ag"
	nwq = 0; nag = 0
	for (i = 1; i <= nos; i++) {
		c = os[i]
		if (!(cpuCore[c] in roleCore)) continue
		if (roleCore[cpuCore[c]] == "wq") wq[++nwq] = c
		else ag[++nag] = c
	}
	spare = chosen - threads
	printf "# plan-layout: proposed CPU layout\n"
	printf "# host: %d socket(s), %d NUMA node(s), %d CPUs, %d cores, Hyper-Threading %s\n", nsockets, nnodes, ncpu, ncores, htname
	printf "# critical NIC on node %s, critical threads: %d\n", nic, threads
	printf "# node %s: housekeeping core %d (CPUs %s), isolated cores: %d (needed %d, spare %d)\n", nic, hkcore, join(hkcpus, nhk, ","), chosen, threads, spare
	printf "ISOLATED_CPUS=(%s)\n", join(isol, niso, " ")
	printf "OS_CPUS=(%s)\n", join(os, nos, " ")
	printf "WORKQUEUE_CPUS=(%s)\n", join(wq, nwq, " ")
	printf "HOUSEKEEPING_PIN_CPUS=(%s)\n", ag[1]
	printf "HOUSEKEEPING_SLICE_CPUS=(%s)\n", join(ag, nag, " ")
	printf "# critical NIC irq_cpus (third field of its NICS entry): %s\n", irq
	printf "# kernel arguments (Guide 01): isolcpus=%s nohz_full=%s rcu_nocbs=%s\n", join(isol, niso, ","), join(isol, niso, ","), join(isol, niso, ",")
}
function check(    n, i, c, iso, os, niso, nos, isoSet, osSet, split_core, hasOS, hasIso, farIso, ok) {
	niso = words(isolated, iso)
	nos = words(oscpus, os)
	for (i = 1; i <= niso; i++) isoSet[iso[i] + 0] = 1
	for (i = 1; i <= nos; i++) osSet[os[i] + 0] = 1
	# rule 3: CPU 0 is never isolated
	if (0 in isoSet) verdict("FAIL", "CPU 0 is isolated (some timers and platform interrupts are stuck to it)")
	else verdict("PASS", "CPU 0 is not isolated")
	# OS_CPUS is the exact complement of ISOLATED_CPUS
	ok = 1
	for (i = 1; i <= ncpu; i++) {
		c = all[i]
		if ((c in isoSet) && (c in osSet)) { verdict("FAIL", "CPU " c " is in both ISOLATED_CPUS and OS_CPUS"); ok = 0 }
		if (!(c in isoSet) && !(c in osSet)) { verdict("FAIL", "CPU " c " is in neither ISOLATED_CPUS nor OS_CPUS"); ok = 0 }
	}
	for (c in isoSet) if (!(c in cpuNode)) { verdict("FAIL", "ISOLATED_CPUS lists CPU " c ", which is not in the topology"); ok = 0 }
	for (c in osSet) if (!(c in cpuNode)) { verdict("FAIL", "OS_CPUS lists CPU " c ", which is not in the topology"); ok = 0 }
	if (ok) verdict("PASS", "OS_CPUS is the exact complement of ISOLATED_CPUS")
	# rule 2: one non-isolated CPU on the NIC's node for its interrupts
	for (i = 1; i <= ncpu; i++) {
		c = all[i]
		if (cpuNode[c] == nic && (c in osSet)) hasOS = 1
		if (cpuNode[c] == nic && (c in isoSet)) hasIso = 1
		if (cpuNode[c] != nic && (c in isoSet)) farIso = farIso " " c
	}
	if (hasOS) verdict("PASS", "node " nic " keeps a housekeeping CPU for the critical NIC interrupts")
	else verdict("FAIL", "no non-isolated CPU on node " nic ": the critical NIC interrupts would land on an isolated CPU")
	# rule 1: the isolated CPUs are on the NIC's node
	if (!hasIso) verdict("FAIL", "no isolated CPU on node " nic ", where the critical NIC is")
	else if (farIso != "") verdict("WARN", "isolated CPUs on another node than the NIC (" nic "):" farIso)
	else verdict("PASS", "every isolated CPU is on node " nic)
	# rule 4: siblings of a core share a role
	ok = 1
	for (i = 1; i <= ncpu; i++) {
		c = all[i]
		if (cpuCore[c] in coreRole) { if (coreRole[cpuCore[c]] != ((c in isoSet) ? "iso" : "os")) split_core[cpuCore[c]] = 1 }
		else coreRole[cpuCore[c]] = ((c in isoSet) ? "iso" : "os")
	}
	for (c in split_core) { verdict("FAIL", "core " c " has one Hyper-Threading sibling isolated and one not"); ok = 0 }
	if (ok) verdict("PASS", "no core is split between isolated and OS CPUs")
}
function verdict(kind, text) {
	printf "%s %s\n", kind, text
	if (kind == "FAIL") rc = 5
}
AWK
}

usage() {
	cat <<EOF
Usage: $(basename "$0") --threads N (--nic-node N | --nic IFACE) [--spares N] [--lscpu FILE]
       $(basename "$0") --check CONF (--nic-node N | --nic IFACE) [--lscpu FILE]

  --threads N     number of latency-critical threads, one isolated CPU each
  --spares N      isolated cores to leave free for growth (default 2)
  --nic-node N    NUMA node of the critical NIC
  --nic IFACE     read the node from /sys/class/net/IFACE/device/numa_node
  --lscpu FILE    topology as printed by: lscpu -b -e=CPU,NODE,SOCKET,CORE (default: run it)
  --check CONF    check ISOLATED_CPUS and OS_CPUS of a lowlat.conf instead of proposing
EOF
}

THREADS=""
SPARES=2
NIC_NODE=""
NIC_IFACE=""
LSCPU_FILE=""
CHECK_CONF=""

while (($# > 0)); do
	case "$1" in
	--threads)
		shift
		THREADS="${1:-}"
		;;
	--spares)
		shift
		SPARES="${1:-}"
		;;
	--nic-node)
		shift
		NIC_NODE="${1:-}"
		;;
	--nic)
		shift
		NIC_IFACE="${1:-}"
		;;
	--lscpu)
		shift
		LSCPU_FILE="${1:-}"
		;;
	--check)
		shift
		CHECK_CONF="${1:-}"
		;;
	-h | --help)
		usage
		exit "${EXIT_OK}"
		;;
	*)
		usage >&2
		die "unknown argument: $1" "${EXIT_USAGE}"
		;;
	esac
	shift
done

is_number() { [[ "$1" =~ ^[0-9]+$ ]]; }

if [[ -n "${NIC_IFACE}" ]]; then
	NIC_NODE="$(read_value "${LOWLAT_ROOT}/sys/class/net/${NIC_IFACE}/device/numa_node" "")"
fi
is_number "${NIC_NODE}" || die "give the critical NIC's NUMA node with --nic-node N, or --nic IFACE on a host where it reports one" "${EXIT_USAGE}"
is_number "${SPARES}" || die "--spares takes a number" "${EXIT_USAGE}"

if [[ -n "${LSCPU_FILE}" ]]; then
	[[ -r "${LSCPU_FILE}" ]] || die "cannot read ${LSCPU_FILE}" "${EXIT_USAGE}"
	TOPOLOGY="$(cat "${LSCPU_FILE}")"
else
	require_commands lscpu
	TOPOLOGY="$(lscpu -b -e=CPU,NODE,SOCKET,CORE)"
fi

PROGRAM="$(plan_awk)"

if [[ -n "${CHECK_CONF}" ]]; then
	[[ -r "${CHECK_CONF}" ]] || die "cannot read ${CHECK_CONF}" "${EXIT_USAGE}"
	# Read the two lists in a subshell, so that nothing else in the file leaks into this script.
	ISOLATED_LIST="$(
		# shellcheck source=lowlat.conf.example
		. "${CHECK_CONF}"
		printf '%s\n' "${ISOLATED_CPUS[*]:-}"
	)"
	OS_LIST="$(
		# shellcheck source=lowlat.conf.example
		. "${CHECK_CONF}"
		printf '%s\n' "${OS_CPUS[*]:-}"
	)"
	status=0
	awk -v mode=check -v nic="${NIC_NODE}" -v isolated="${ISOLATED_LIST}" -v oscpus="${OS_LIST}" "${PROGRAM}" <<<"${TOPOLOGY}" || status=$?
	exit "${status}"
fi

is_number "${THREADS}" || die "--threads N is required (the number of latency-critical threads)" "${EXIT_USAGE}"
status=0
awk -v mode=propose -v nic="${NIC_NODE}" -v threads="${THREADS}" -v spares="${SPARES}" "${PROGRAM}" <<<"${TOPOLOGY}" || status=$?
exit "${status}"
