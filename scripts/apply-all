#!/usr/bin/env bash
#
# apply-all - applies Guides 00-08 and 10-12 in order, or re-applies their runtime part.
#
#   --plan      print what each capability would do on this host class, change nothing
#   --dry-run   print every command and file, change nothing
#   --apply     apply everything and install lowlat-runtime.service (root)
#   --runtime   re-apply only non-persistent state (called at boot by lowlat-runtime.service)
#   --rollback  stop boot reapplication and undo the applied guides
#   --verify    run verify-tuning
#
# Every guide script can also be run on its own; this wrapper only sequences them and
# prints a step-timing summary.

set -Eeuo pipefail
SCRIPTS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

# shellcheck source=lib/common
. "${SCRIPTS_DIR}/lib/common"
# shellcheck source=00-bios-firmware
. "${SCRIPTS_DIR}/00-bios-firmware"
# shellcheck source=01-grub-bootloader
. "${SCRIPTS_DIR}/01-grub-bootloader"
# shellcheck source=02-cpu-isolation
. "${SCRIPTS_DIR}/02-cpu-isolation"
# shellcheck source=03-huge-pages
. "${SCRIPTS_DIR}/03-huge-pages"
# shellcheck source=04-network
. "${SCRIPTS_DIR}/04-network"
# shellcheck source=05-cgroup-isolation
. "${SCRIPTS_DIR}/05-cgroup-isolation"
# shellcheck source=06-kernel-sysctl
. "${SCRIPTS_DIR}/06-kernel-sysctl"
# shellcheck source=07-os-hygiene
. "${SCRIPTS_DIR}/07-os-hygiene"
# shellcheck source=08-kernel-bypass
. "${SCRIPTS_DIR}/08-kernel-bypass"
# shellcheck source=10-time-sync
. "${SCRIPTS_DIR}/10-time-sync"
# shellcheck source=11-day2-operations
. "${SCRIPTS_DIR}/11-day2-operations"
# shellcheck source=12-memory-pressure
. "${SCRIPTS_DIR}/12-memory-pressure"

RUNTIME_UNIT="${LOWLAT_ROOT}"/etc/systemd/system/lowlat-runtime.service

print_header() {
	local os kernel now
	os="$(awk -F= '$1=="PRETTY_NAME"{gsub(/"/,"",$2); print $2}' "${LOWLAT_ROOT}"/etc/os-release 2>/dev/null || uname -s)"
	kernel="$(uname -r)"
	now="$(date '+%Y-%m-%d %H:%M:%S')"
	printf 'LOW-LATENCY TUNING (%s)\n' "$1"
	printf '  os:         %s\n' "${os}"
	printf '  kernel:     %s\n' "${kernel}"
	printf '  host class: %s\n' "${HOST_CLASS}"
	printf '  config:     %s\n' "${LOWLAT_CONFIG}"
	printf '  date:       %s\n' "${now}"
	[[ "${DRY_RUN}" -eq 1 ]] && printf '  mode:       DRY-RUN (nothing is changed)\n'
	return 0
}

print_plan() {
	local capability decision
	printf 'host_class=%s\n' "${HOST_CLASS}"
	for capability in bios_firmware latency_grub isolation_grub core_isolation irqbalance_disable rt_throttling \
		huge_pages sysctl os_hygiene memory_pressure time_sync cgroup_isolation nic_tuning nic_irq_affinity kernel_bypass day2_operations; do
		decision="$(capability_decision "${capability}")"
		printf '%-20s %s\n' "${capability}" "${decision}"
	done
	printf '%-20s %s\n' flush_firewall "${FLUSH_FIREWALL_RULES:-no}"
	printf '%-20s %s\n' remove_netfilter "${REMOVE_NETFILTER_MODULES:-no}"
	printf '%-20s %s\n' bypass_stack "${KERNEL_BYPASS_STACK:-none}"
	printf '%-20s %s\n' time_sync_mode "${TIME_SYNC_MODE:-none}"
	printf '%-20s %s\n' day2_verify_timer "${DAY2_VERIFY_TIMER:-yes}"
	printf '%-20s %s\n' swap_policy "${SWAP_POLICY:-off}"
}

install_runtime_unit() {
	local config_dir dir=. escaped
	# Absolute path for the unit file. A dry-run may point at a config that does not exist yet.
	[[ "${LOWLAT_CONFIG}" == */* ]] && dir="${LOWLAT_CONFIG%/*}"
	if config_dir="$(cd "${dir}" 2>/dev/null && pwd -P)"; then
		LOWLAT_CONFIG="${config_dir}/${LOWLAT_CONFIG##*/}"
	fi
	# Escape the characters that are special in a sed replacement.
	escaped="${LOWLAT_CONFIG//\\/\\\\}"
	escaped="${escaped//&/\\&}"
	escaped="${escaped//|/\\|}"
	log_sub_step "Installing ${RUNTIME_UNIT} (ExecStart=${SCRIPTS_DIR}/apply-all --runtime)"
	sed "s|^ExecStart=.*|ExecStart=${SCRIPTS_DIR}/apply-all --runtime|; s|^Environment=LOWLAT_CONFIG=.*|Environment=LOWLAT_CONFIG=${escaped}|; s|^ConditionPathExists=.*|ConditionPathExists=${escaped}|" \
		"${SCRIPTS_DIR}/systemd/lowlat-runtime.service" | write_file "${RUNTIME_UNIT}"
	run systemctl daemon-reload
	run systemctl enable lowlat-runtime.service
}

# Capture the runtime unit before any guide can change host state.
remember_apply_all() {
	remember_file "${RUNTIME_UNIT}"
	remember_service lowlat-runtime.service
	remember_value apply-all/started yes
	# TuneD and a bypass driver reload can change NIC defaults before Guide 04.
	remember_network
}

# guide_capabilities <guide> - the capabilities that a guide acts on (see print_plan).
guide_capabilities() {
	case "$1" in
	00-bios-firmware) printf 'bios_firmware\n' ;;
	01-grub-bootloader) printf 'latency_grub isolation_grub\n' ;;
	02-cpu-isolation) printf 'core_isolation irqbalance_disable rt_throttling\n' ;;
	03-huge-pages) printf 'huge_pages\n' ;;
	04-network) printf 'nic_tuning nic_irq_affinity\n' ;;
	05-cgroup-isolation) printf 'cgroup_isolation\n' ;;
	06-kernel-sysctl) printf 'sysctl\n' ;;
	07-os-hygiene) printf 'os_hygiene\n' ;;
	08-kernel-bypass) printf 'kernel_bypass\n' ;;
	10-time-sync) printf 'time_sync\n' ;;
	11-day2-operations) printf 'day2_operations\n' ;;
	12-memory-pressure) printf 'memory_pressure\n' ;;
	*) die "no capabilities known for ${1}" ;;
	esac
}

# stage_applies <guide> - true when the host class lets at least one capability of the
# guide apply. A guide that is skipped changes nothing, so a rollback must not touch what
# it does not manage (a VM with its own huge page pool, say).
stage_applies() {
	local capability decision
	for capability in $(guide_capabilities "$1"); do
		decision="$(capability_decision "${capability}")"
		[[ "${decision}" == apply ]] && return 0
	done
	return 1
}

# mark_stage <guide> <yes|no> - what this apply did with the guide. "no" is written once, as
# a baseline. "yes" always wins: an apply on another host class can apply what an earlier
# one skipped.
mark_stage() {
	local file="${LOWLAT_FACTORY_DIR}/.values/apply-all/guides/$1"
	[[ "${DRY_RUN}" -eq 1 ]] && return 0
	if [[ "$2" == no ]]; then
		remember_value "apply-all/guides/$1" no
		return 0
	fi
	mkdir -p "${file%/*}"
	printf '%s\n' yes >"${file}"
	chmod 0600 "${file}"
}

apply_stage() {
	local guide="$1"
	shift
	if stage_applies "${guide}"; then
		mark_stage "${guide}" yes
		if [[ "${guide}" == 08-kernel-bypass ]]; then
			mark_stage 04-network yes
		fi
	else
		mark_stage "${guide}" no
	fi
	"$@"
}

rollback_all() {
	local guide value complete=no
	local -a failed=()
	local -a guides=(11-day2-operations 08-kernel-bypass 04-network 05-cgroup-isolation
		10-time-sync 12-memory-pressure 07-os-hygiene 06-kernel-sysctl 03-huge-pages 02-cpu-isolation
		01-grub-bootloader 00-bios-firmware)
	if [[ ! -f "${LOWLAT_FACTORY_DIR}/.values/apply-all/started" ]]; then
		# An apply-all from before this rollback existed left the unit and no record. Its guides
		# have no saved baseline either, so the wrapper cannot undo them: say so, change nothing.
		if grep -q '^Description=Low-latency runtime tuning' "${RUNTIME_UNIT}" 2>/dev/null; then
			die "${RUNTIME_UNIT} was installed by an older apply-all that kept no rollback record. Nothing was changed. Run 'systemctl disable --now lowlat-runtime.service' and roll the guides back one by one, as each guide's rollback section says" "${EXIT_PRECHECK}"
		fi
		return 0
	fi
	value="$(original_value apply-all/started)"
	[[ "${value}" == yes ]] || die "invalid saved wrapper apply marker"
	log_step "Stopping boot-time reapplication"
	if systemctl cat lowlat-runtime.service >/dev/null 2>&1; then
		run systemctl stop lowlat-runtime.service
		run systemctl disable lowlat-runtime.service
	fi
	if [[ -f "${LOWLAT_FACTORY_DIR}/.values/apply-all/complete" ]]; then
		complete="$(original_value apply-all/complete)"
		[[ "${complete}" == yes ]] || die "invalid saved wrapper completion marker"
	fi
	for guide in "${guides[@]}"; do
		if [[ "${complete}" == no && ! -f "${LOWLAT_FACTORY_DIR}/.values/apply-all/guides/${guide}" ]]; then continue; fi
		value="$(original_value "apply-all/guides/${guide}")"
		if [[ "${value}" == no ]]; then
			log_sub_step "Skipping ${guide}: apply-all did not apply it on this host"
			continue
		fi
		[[ "${value}" == yes ]] || die "invalid saved apply marker for ${guide}"
		log_step "Rollback ${guide}"
		# A failed guide must not leave the guides after it, and the runtime unit, half restored.
		if ! "${SCRIPTS_DIR}/${guide}" --rollback --config "${LOWLAT_CONFIG}"; then
			failed+=("${guide}")
			log_warn "Rollback of ${guide} failed: going on with the other guides"
		fi
	done
	log_step "Restoring the original runtime unit"
	restore_file "${RUNTIME_UNIT}"
	run systemctl daemon-reload
	restore_service lowlat-runtime.service
	if ((${#failed[@]} > 0)); then
		die "rollback of ${failed[*]} failed and the other guides were rolled back. Read the errors above, fix the cause, and run apply-all --rollback again" "${EXIT_APPLY}"
	fi
	printf '\nReboot to restore boot parameters and inherited service affinity.\n'
}

apply_all() {
	print_header apply
	remember_apply_all
	apply_stage 00-bios-firmware apply_bios_firmware                 # 00 (PCIe ASPM; the BIOS setup itself is manual)
	apply_stage 01-grub-bootloader apply_grub_kernel_parameters        # 01 (reboot)
	apply_stage 02-cpu-isolation apply_cpu_isolation                 # 02 (reboot for systemd CPUAffinity)
	apply_stage 03-huge-pages apply_huge_pages                    # 03 (reboot for reliable reservation)
	apply_stage 06-kernel-sysctl apply_kernel_sysctl                 # 06
	apply_stage 07-os-hygiene apply_os_hygiene                    # 07 (tuned re-applies sysctl.d after its own)
	apply_stage 12-memory-pressure apply_memory_pressure               # 12 (swap off, OOM order of the latency services)
	apply_stage 10-time-sync apply_time_sync                     # 10 (chrony or ptp4l/phc2sys, pinned)
	apply_stage 05-cgroup-isolation apply_cgroup_isolation              # 05
	apply_stage 08-kernel-bypass apply_kernel_bypass                 # 08 (before 04: a driver reload resets the NICs)
	apply_stage 04-network apply_network                       # 04 (runtime)
	apply_stage 11-day2-operations apply_day2_operations               # 11 (verification timer)
	log_step "Boot-time re-application of runtime settings"
	install_runtime_unit
	remember_value apply-all/complete yes
	print_step_timing_table
	printf '\nReboot required for GRUB, systemd CPUAffinity and huge page reservation.\n'
	printf 'After the reboot: %s/verify-tuning\n' "${SCRIPTS_DIR}"
}

apply_all_runtime() {
	print_header runtime
	apply_bios_firmware_runtime         # 00 PCIe ASPM policy
	apply_cpu_isolation_runtime         # 02 workqueue mask
	apply_kernel_bypass_runtime         # 08 DPDK port binding (before 04 tunes what the kernel keeps)
	apply_network                       # 04 NIC settings + IRQ affinity
	apply_cgroup_isolation_runtime      # 05 pin agents
	apply_os_hygiene_runtime            # 07 opt-in firewall / modules
	apply_memory_pressure_runtime       # 12 zswap off
	print_step_timing_table
}

apply_all_main() {
	if [[ "${1:-}" == --plan ]]; then
		shift
		parse_mode_args "$@" || true
		MODE=plan
	else
		parse_mode_args "$@" || true
	fi
	case "${MODE}" in
	plan)
		load_config
		print_plan
		;;
	apply)
		require_root
		load_config
		host_allows_apply || die "host_class=${HOST_CLASS} is not supported for tuning" "${EXIT_PRECHECK}"
		apply_all
		;;
	runtime)
		require_root
		load_config
		apply_all_runtime
		;;
	rollback)
		require_root
		load_config
		rollback_all
		;;
	verify)
		exec "${SCRIPTS_DIR}/verify-tuning" "$@"
		;;
	*)
		print_usage
		printf '  --plan       show the capability decisions for this host class\n'
		;;
	esac
}

apply_all_main "$@"
