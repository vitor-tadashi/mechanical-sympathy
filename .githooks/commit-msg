#!/usr/bin/env bash
#
# commit-msg - check the commit title, the blank line after it, and the description. Installed by tools/install-git-hooks.
# Skip once with: git commit --no-verify

set -Eeuo pipefail

ROOT="$(git rev-parse --show-toplevel)"
# Drop comment lines as git does; the title is the first remaining line.
message="$(grep -v '^#' "$1" || true)"
title="$(head -n 1 <<<"${message}")"
second="$(sed -n 2p <<<"${message}")"

"${ROOT}/tools/check-commit-title" "${title}"
"${ROOT}/tools/check-description" <<<"${message}"
if [[ -n "${second}" ]]; then
	printf 'commit-msg: leave a blank line between the title and the body\n' >&2
	exit 1
fi
